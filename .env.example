# ── Resend ────────────────────────────────────────────
# Rota la key si alguna vez la compartiste en texto plano.
# Necesita "Full access" para gestionar audiencias/contactos.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Remitente. DEBE ser un dominio verificado en Resend.
RESEND_FROM="André Valle <noreply@tudominio.com>"

# Bandeja donde llegan los mensajes del formulario de contacto.
RESEND_CONTACT_TO=andrevalleo13@gmail.com

# ID de la audiencia de newsletter (Resend → Audiences → tu audiencia).
RESEND_AUDIENCE_ID=00000000-0000-0000-0000-000000000000

# Opcional: audiencia de leads del formulario (solo registro, sin marketing).
# RESEND_LEADS_AUDIENCE_ID=00000000-0000-0000-0000-000000000000
