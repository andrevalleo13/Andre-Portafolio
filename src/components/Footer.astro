---
/**
 * ── Footer Component ──────────────────────────────────
 *
 * Fondo tinta que se va pintando: al llegar caen unas manchas solas
 * y el cursor salpica pintura (gotas orgánicas, latigazos,
 * escurrimientos), como los GATs pintados de Margiela
 * (`scripts/splatter.ts`). Encima:
 *   · "let's talk." gigante en Hubot negra roja (igual en EN y ES).
 *   · El email en Redaction, subrayado a pluma.
 *   · El índice como la numeración 0–23 de Margiela.
 *   · Una línea base: etiqueta roja, redes, © y volver arriba.
 */
import { navItems } from '../i18n/ui';
import { getLangFromUrl, useTranslations, getLocalePath } from '../i18n/utils';
import Etiqueta from './art/Etiqueta.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const label = (id: string) => t(`nav.${id}` as Parameters<typeof t>[0]);

const basePath = Astro.url.pathname.replace(/^\/es(?=\/|$)/, '').replace(/\/$/, '') || '/';
const index = [{ id: 'home', href: '/' }, ...navItems];
const current = Math.max(
  0,
  index.findIndex((item) =>
    item.href === '/' ? basePath === '/' : basePath === item.href || basePath.startsWith(`${item.href}/`)
  )
);
const numbers = Array.from({ length: 24 }, (_, n) => n);

const socials = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/andrevalleo' },
  { label: 'X', href: 'https://x.com/andrevalleee' },
  { label: 'Instagram', href: 'https://www.instagram.com/andre.valleee/' },
];
---

<footer class="footer" data-splatter-host>
  <canvas class="footer__paint" data-splatter aria-hidden="true"></canvas>

  <div class="footer__inner">
    <div class="footer__stage">
      <h2 class="footer__title" data-reveal="lines">
        <span class="lv-line"><span>let's</span></span>
        <span class="lv-line footer__title-2"><span>talk.</span></span>
      </h2>

      <div class="footer__side">
        <a class="footer__mail" href={getLocalePath('/contact', lang)} id="footer-contact-link" data-reveal="fade" data-delay="0.2">
          <span data-pen="under">andrevalleo13@gmail.com</span>
          <svg width="0.5em" height="0.5em" viewBox="0 0 8 8" fill="none" aria-hidden="true">
            <path d="M0.5 7.5L7.5 0.5M7.5 0.5H1.5M7.5 0.5V6.5" stroke="currentColor" stroke-width="0.6" />
          </svg>
        </a>

        <nav class="footer__index" aria-label={t('footer.index')} data-reveal="fade" data-delay="0.35">
          <div class="footer__nums" aria-hidden="true">
            {numbers.map((n) =>
              n < index.length ? (
                <a href={getLocalePath(index[n].href, lang)} tabindex="-1" data-n={n} data-pen data-pen-on={n === current ? '' : undefined}>{n}</a>
              ) : (
                <span>{n}</span>
              )
            )}
          </div>
          <ul class="footer__legend">
            {index.map((item, n) => (
              <li>
                <a href={getLocalePath(item.href, lang)} data-n={n} aria-current={n === current ? 'page' : undefined}>
                  <span>{n}</span>{label(item.id)}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>

    <div class="footer__tools">
      <p class="footer__hint">{t('footer.paint')}</p>
      <button class="footer__clear" type="button" data-splatter-clear>{t('footer.clear')}</button>
    </div>

    <div class="footer__base">
      <Etiqueta variant="full" mark={current} />
      <ul class="footer__social" aria-label={t('footer.social')}>
        {socials.map((s) => (
          <li><a href={s.href} target="_blank" rel="noopener"><span data-pen="under">{s.label}</span> ↗</a></li>
        ))}
      </ul>
      <div class="footer__end">
        <p>{t('footer.copy')}<br />{t('footer.handmade')}</p>
        <button class="footer__top" type="button" data-top>{t('footer.top')} ↑</button>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    --papel-90: rgba(244, 242, 237, 0.92);
    --papel-55: rgba(244, 242, 237, 0.55);
    --papel-20: rgba(244, 242, 237, 0.18);
    --accent: #e2533f;
    position: relative;
    z-index: 10;
    isolation: isolate;
    overflow: hidden;
    background: #15130f;
    color: var(--papel-90);
  }

  .footer__paint {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: block;
    width: 100%;
    height: 100%;
    cursor: crosshair;
  }

  .footer__inner {
    display: grid;
    gap: clamp(40px, 5vw, 72px);
    max-width: 1560px;
    margin: 0 auto;
    padding: clamp(96px, 12vw, 190px) var(--gutter) clamp(28px, 3vw, 44px);
  }

  /* ── Escenario ── */
  .footer__stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 48px 5vw;
    align-items: end;
  }

  /* "creative director of my life": negra, minúsculas, apretada, roja */
  .footer__title {
    font-family: var(--f-grot);
    font-weight: 900;
    font-size: clamp(5rem, 19vw, 23rem);
    line-height: 0.78;
    letter-spacing: -0.065em;
    text-transform: lowercase;
    color: var(--accent);
    margin-left: -0.6vw;
    pointer-events: none;
  }

  .footer__title-2 { padding-left: 14vw; }

  .footer__side {
    display: grid;
    gap: clamp(32px, 4vw, 56px);
    justify-items: start;
    padding-bottom: 1.4vw;
  }

  .footer__mail {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    max-width: 100%;
    font-family: var(--f-serif);
    font-size: clamp(1.4rem, 2.4vw, 2.5rem);
    letter-spacing: -0.02em;
    color: var(--papel-90);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .footer__mail svg { flex-shrink: 0; transition: translate 0.6s var(--ease-expo); }
  .footer__mail:hover svg { translate: 4px -4px; }

  /* ── Índice: numeración 0–23 de Margiela ── */
  .footer__index {
    display: grid;
    grid-template-columns: auto auto;
    gap: 32px;
    align-items: start;
  }

  .footer__nums {
    display: grid;
    grid-template-columns: repeat(6, 2.2rem);
    gap: 0.45rem 0.1rem;
    font-family: var(--f-grot);
    font-size: 1rem;
    font-weight: 500;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .footer__nums span { color: var(--papel-20); }
  .footer__nums a { color: var(--papel-90); text-decoration: none; }

  .footer__legend {
    list-style: none;
    display: grid;
    gap: 4px;
  }

  .footer__legend a {
    display: inline-flex;
    gap: 0.8rem;
    font-family: var(--f-serif);
    font-size: 1.02rem;
    color: var(--papel-90);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .footer__legend a span {
    width: 1rem;
    font-family: var(--f-grot);
    font-size: 0.7rem;
    line-height: 1.7;
    color: var(--papel-55);
  }

  .footer__legend a:hover,
  .footer__legend a[aria-current='page'] { color: var(--accent); font-style: italic; }

  /* ── Pintura: pista y limpiar ── */
  .footer__tools {
    display: flex;
    align-items: baseline;
    gap: 18px;
    font-family: var(--f-serif);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--papel-55);
  }

  .footer__clear {
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--papel-20);
    background: none;
    color: var(--papel-90);
    font: inherit;
    cursor: pointer;
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .footer__clear:hover { color: var(--accent); border-color: var(--accent); }

  /* ── Línea base ── */
  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 28px 40px;
    padding-top: 24px;
    border-top: 1px solid var(--papel-20);
    font-family: var(--f-grot);
    font-size: 0.74rem;
    line-height: 1.6;
    color: var(--papel-55);
  }

  .footer__social {
    list-style: none;
    display: flex;
    gap: 1.6rem;
    font-size: 0.86rem;
  }

  .footer__social a { color: var(--papel-90); text-decoration: none; }
  .footer__social a:hover { color: var(--accent); }

  .footer__end {
    display: grid;
    justify-items: end;
    gap: 10px;
    text-align: right;
  }

  .footer__top {
    padding: 0;
    border: 0;
    background: none;
    color: var(--papel-90);
    font: inherit;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .footer__top:hover { color: var(--accent); }

  @media (max-width: 1000px) {
    .footer__stage { grid-template-columns: minmax(0, 1fr); }
    .footer__title { font-size: 28vw; }
    .footer__title-2 { padding-left: 10vw; }
  }

  @media (max-width: 640px) {
    .footer__index { grid-template-columns: minmax(0, 1fr); }
    .footer__base { flex-direction: column; align-items: flex-start; }
    .footer__end { justify-items: start; text-align: left; }
  }

  @media (hover: none), (pointer: coarse) {
    .footer__tools { display: none; }
  }
</style>

<script>
  /* Volver arriba (con el scroll suave si está activo) */
  function initFooter() {
    document.querySelectorAll<HTMLButtonElement>('[data-top]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const lenis = (window as any).__lenis;
        if (lenis) lenis.scrollTo(0, { duration: 1.6 });
        else window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });

    /* Pasar el cursor por "Trabajo" encierra el 1 en la numeración. */
    document.querySelectorAll<HTMLAnchorElement>('.footer__legend a[data-n]').forEach((link) => {
      if (link.dataset.bound) return;
      link.dataset.bound = 'true';
      const twin = document.querySelector(`.footer__nums a[data-n="${link.dataset.n}"]`);
      if (!twin) return;
      link.addEventListener('pointerenter', () => twin.dispatchEvent(new PointerEvent('pointerenter')));
      link.addEventListener('pointerleave', () => twin.dispatchEvent(new PointerEvent('pointerleave')));
    });
  }

  initFooter();
  document.addEventListener('astro:page-load', initFooter);
</script>
