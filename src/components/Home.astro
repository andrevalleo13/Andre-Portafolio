---
/**
 * ── Home (EN + ES) ────────────────────────────────────
 *
 * "Lujo vivido, con un toque": composición libre, como collage.
 * Se usa en src/pages/index.astro y src/pages/es/index.astro;
 * el idioma sale de la URL. Cada sección vive en src/components/home/.
 *
 *   Portada     collage arrastrable
 *   I.   Tesis       tipografía escalonada + KPIs
 *   II.  Holdings    láminas en scroll horizontal
 *   III. Colección   pared de cuadros a lo salón
 *   IV.  Memos       lista escalonada
 *   (V. Contacto es el footer)
 *
 * Animaciones: src/scripts/ink.ts · scroll suave: src/scripts/smooth.ts
 */
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { getWork, workSlug as slug } from '../lib/work';
import { getMemos } from '../lib/journal';
import Cover from './home/Cover.astro';
import Tesis from './home/Tesis.astro';
import Holdings from './home/Holdings.astro';
import Coleccion from './home/Coleccion.astro';
import Memos from './home/Memos.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

/* ── Trabajo ── */
const work = await getWork(lang);

/* ── Diario ── */
const allMemos = await getMemos(lang);

/* ── Datos del catálogo ── */
const now = new Date();
const edition = `${String(now.getMonth() + 1).padStart(2, '0')}.${now.getFullYear()}`;
const firstNumber = (s: string) => Number(s.match(/\d+/)?.[0] ?? 0);
const flouvia = work.find((w) => slug(w.id) === 'flouvia');

const kpis = [
  { value: work.length, label: t('home.kpi.ventures') },
  { value: flouvia ? firstNumber(flouvia.data.impact) : 0, suffix: '+', label: t('home.kpi.infra') },
  { value: allMemos.length, label: t('home.kpi.memos') },
];

---

<main class="home">
  <Cover lots={work.length} memos={allMemos.length} edition={edition} />
  <Tesis kpis={kpis} />
  <Holdings work={work} />
  <Coleccion />
  <Memos memos={allMemos.slice(0, 5)} />
</main>

<style>
  .home {
    display: grid;
    /* minmax(0,…): ningún hijo ancho (nowrap) debe ensanchar la columna */
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    padding: 0 var(--gutter) clamp(120px, 14vw, 220px);
    overflow-x: clip;
  }

  .home > :global(*) {
    width: 100%;
    max-width: 1560px;
    margin-inline: auto;
  }

  /* Secciones seguidas, sin huecos: solo un respiro antes de cada folio */
  .home > :global(section + section) {
    padding-top: clamp(32px, 4vw, 56px);
  }
</style>
