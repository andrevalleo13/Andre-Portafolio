---
/**
 * ── Journal: memo (EN + ES) ───────────────────────────
 *
 * Una barra roja arriba marca cuánto falta por leer. Cabecera con
 * número de memo, fecha y lectura; título grande en Redaction; el
 * texto con capitular roja en negra condensada. Al final, el memo
 * siguiente (más antiguo) y la suscripción.
 */
import { render } from 'astro:content';
import { getLangFromUrl, getLocalePath } from '../i18n/utils';
import { memoHref, memoDate, type Memo } from '../lib/journal';
import Pieza from './home/Pieza.astro';
import Trazo from './art/Trazo.astro';
import Newsletter from './Newsletter.astro';

interface Props {
  memo: Memo;
  n: number;
  next?: Memo;
}

const { memo, n, next } = Astro.props;
const { Content } = await render(memo);
const lang = getLangFromUrl(Astro.url);
const pad = (x: number) => String(x).padStart(2, '0');
const L = lang === 'es'
  ? { back: 'Diario', next: 'Memo siguiente' }
  : { back: 'Journal', next: 'Next memo' };
---

<div class="j-progress" aria-hidden="true"><i data-progress></i></div>

<main class="post">
  <header class="post-head" data-collage>
    <p class="lv-kicker post-meta" data-reveal="fade" data-delay="0.1">
      <a href={getLocalePath('/journal', lang)}>← {L.back}</a>
      <span>Memo Nº {pad(n)}</span>
      <span>{memoDate(memo.data.date)}</span>
      <span>{memo.data.readTime}</span>
    </p>
    <h1 class="post-title" data-reveal="lines" data-delay="0.2">
      <span class="lv-line"><span>{memo.data.title}</span></span>
    </h1>
    <Pieza x="80%" y="24%" w="14vw" z={0} depth={0.15} reveal={false} hideMobile>
      <Trazo kind="tachas" draw="load" delay={0.9} />
    </Pieza>
  </header>

  <article class="post-body lv-prose">
    <Content />
  </article>

  <footer class="post-end">
    {next && (
      <a href={memoHref(next, lang)} class="post-next" data-pen-group>
        <span class="lv-kicker">{L.next} · Memo Nº {pad(n - 1)}</span>
        <span class="post-next__title"><span data-pen="under">{next.data.title}</span> →</span>
      </a>
    )}
    <Newsletter />
  </footer>
</main>

<style>
  .j-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 210;
    height: 3px;
    pointer-events: none;
  }

  .j-progress i {
    display: block;
    height: 100%;
    background: var(--rojo);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  .post {
    padding: 0 var(--gutter) clamp(110px, 12vw, 180px);
    overflow-x: clip;
  }

  .post > * { max-width: 1240px; margin-inline: auto; }

  .post-head {
    position: relative;
    padding: clamp(110px, 14vh, 150px) 0 clamp(48px, 6vw, 90px);
    border-bottom: 1px solid var(--tinta);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
  }

  .post-meta a { color: inherit; text-decoration: none; }
  .post-meta a:hover { color: var(--rojo); }

  .post-title {
    position: relative;
    z-index: 2;
    max-width: 16ch;
    margin-top: clamp(24px, 3vw, 44px);
    font-family: var(--f-serif);
    font-weight: 400;
    font-size: clamp(3rem, 8vw, 8.6rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .post-title .lv-line > span { display: inline; }

  /* Ancho de lectura: ~70 caracteres (le gana a `.post > *`) */
  .post > .post-body {
    max-width: min(44rem, 100%);
    padding-top: clamp(48px, 6vw, 96px);
    margin-left: clamp(0px, 14vw, 220px);
  }

  /* Capitular roja en negra condensada */
  .post-body :global(> p:first-of-type::first-letter) {
    float: left;
    margin: 0.06em 0.12em 0 0;
    font-family: var(--f-grot);
    font-weight: 900;
    font-stretch: 75%;
    font-size: 4.4em;
    line-height: 0.78;
    color: var(--rojo);
  }

  .post-end {
    display: grid;
    gap: clamp(56px, 7vw, 110px);
    margin-top: clamp(72px, 8vw, 130px);
    padding-top: 28px;
    border-top: 1px solid var(--tinta);
  }

  .post-next {
    justify-self: stretch;
    display: grid;
    gap: 12px;
    color: var(--tinta);
    text-decoration: none;
  }

  .post-next__title {
    font-family: var(--f-serif);
    font-size: clamp(2.2rem, 5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .post-next__title > span { display: inline; }
  .post-next:hover .post-next__title { font-family: var(--f-worn); }

  @media (max-width: 900px) {
    .post > .post-body { margin-left: 0; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  /* Barra roja de lectura: avanza con el texto del memo. */
  function initProgress() {
    const bar = document.querySelector<HTMLElement>('[data-progress]');
    const body = document.querySelector<HTMLElement>('.post-body');
    if (!bar || !body || bar.dataset.bound) return;
    bar.dataset.bound = 'true';
    gsap.to(bar, {
      scaleX: 1,
      ease: 'none',
      scrollTrigger: { trigger: body, start: 'top 70%', end: 'bottom bottom', scrub: true },
    });
  }

  initProgress();
  document.addEventListener('astro:page-load', initProgress);
</script>
