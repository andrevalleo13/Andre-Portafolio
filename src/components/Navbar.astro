---
/**
 * ── Navbar Component ──────────────────────────────────
 *
 * Mínima, en las esquinas:
 *   [etiqueta roja]                         EN/ES   Contacto   Índice ●
 * Transparente al inicio → papel + línea fina al hacer scroll; se
 * esconde al bajar y regresa al subir.
 *
 * "Índice" abre una hoja a pantalla completa compuesta como collage:
 * las secciones en Bodoni gigante, sueltas y a escalas distintas, con
 * su número de etiqueta (guiño a Margiela) y dibujos alrededor. Se
 * abre como una gota de tinta que se expande desde el botón.
 * La página actual queda en cursiva roja, encerrada con la pluma.
 * Colores desde los alias de superficie (--bg, --fg…) definidos en Base.
 */
import { navItems, languages } from '../i18n/ui';
import { getLangFromUrl, useTranslations, getLocalePath, getAlternateLangPath } from '../i18n/utils';
import Etiqueta from './art/Etiqueta.astro';
import Caballo from './art/Caballo.astro';
import Trazo from './art/Trazo.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const alternate = getAlternateLangPath(Astro.url.pathname);
const label = (id: string) => t(`nav.${id}` as Parameters<typeof t>[0]);

const basePath = Astro.url.pathname.replace(/^\/es(?=\/|$)/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? basePath === '/' : basePath === href || basePath.startsWith(`${href}/`);

const overlayItems = [{ id: 'home', href: '/' }, ...navItems];

const langLinks = Object.entries(languages).map(([code, text]) => ({
  code,
  text,
  href: code === alternate.lang ? alternate.href : Astro.url.pathname,
  active: code === lang,
}));
---

<header class="nav" id="navbar">
  <a class="nav__brand" href={getLocalePath('/', lang)} aria-label={`André Valle Ortega · ${label('home')}`}>
    <Etiqueta class="nav__etiqueta" />
  </a>

  <div class="nav__right">
    <div class="nav__lang">
      {langLinks.map((l, i) => (
        <>
          {i > 0 && <span aria-hidden="true">/</span>}
          <a href={l.href} hreflang={l.code} class:list={{ 'is-active': l.active }} id={`lang-${l.code}`}>{l.text}</a>
        </>
      ))}
    </div>
    <a
      class="nav__contact"
      href={getLocalePath('/contact', lang)}
      id="nav-contact"
      data-pen
      aria-current={isActive('/contact') ? 'page' : undefined}
    >{label('contact')}</a>
    <button class="nav__menu" id="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-overlay">
      <span class="nav__menu-open">{t('home.index')}</span>
      <span class="nav__menu-close">{t('nav.close')}</span>
      <i aria-hidden="true"></i>
    </button>
  </div>
</header>

<div class="overlay" id="mobile-overlay" aria-hidden="true" inert data-lenis-prevent>
  <div class="overlay__marks" aria-hidden="true">
    <div class="overlay__ocre"><Trazo kind="verde" draw="none" /></div>
    <div class="overlay__agua"><Trazo kind="puntos" draw="none" /></div>
    <div class="overlay__horse"><Caballo draw="none" /></div>
    <div class="overlay__dog"><Trazo kind="estrellas" draw="none" /></div>
  </div>

  <nav aria-label={t('nav.main')}>
    <ul class="overlay__links">
      {overlayItems.map((item, i) => (
        <li class:list={['overlay__item', `overlay__item--${i}`]} style={`--i:${i}`}>
          <a
            href={getLocalePath(item.href, lang)}
            class="overlay__link"
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <span class="overlay__num">{i}</span>
            <span class="overlay__label" data-pen aria-current={isActive(item.href) ? 'page' : undefined}>{label(item.id)}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="overlay__foot">
    <div class="nav__lang overlay__lang">
      {langLinks.map((l, i) => (
        <>
          {i > 0 && <span aria-hidden="true">/</span>}
          <a href={l.href} hreflang={l.code} class:list={{ 'is-active': l.active }}>{l.text}</a>
        </>
      ))}
    </div>
    <span>andrevalleo13@gmail.com</span>
  </div>
</div>

<style>
  /* ────────────────────────────────────────
     BARRA
  ──────────────────────────────────────── */
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 200;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.3rem var(--gutter);
    color: var(--fg);
    transition:
      background-color 0.5s var(--ease-expo),
      box-shadow 0.5s var(--ease-expo),
      padding 0.6s var(--ease-expo),
      translate 0.8s var(--ease-expo);
  }

  .nav.is-scrolled {
    background-color: var(--bg);
    box-shadow: 0 1px 0 var(--rule);
    padding-block: 0.8rem;
  }

  .nav.is-hidden { translate: 0 -105%; }

  /* Con el índice abierto la barra queda sobre papel, en cualquier superficie */
  .nav.is-open {
    --fg: var(--tinta);
    --bg: var(--papel);
    --fg-soft: var(--grafito);
    background-color: transparent;
    box-shadow: none;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
    color: var(--fg);
    text-decoration: none;
  }

  .nav__brand :global(.nav__etiqueta) {
    transition: rotate 0.8s var(--ease-expo);
  }

  .nav__brand:hover :global(.nav__etiqueta) { rotate: -3deg; }

  .nav__right {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 2.4vw, 2.2rem);
  }

  .nav__lang {
    display: flex;
    gap: 0.45rem;
    font-family: var(--f-grot);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--fg-soft);
  }

  .nav__lang a {
    color: var(--fg-soft);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .nav__lang a:hover { color: var(--fg); }

  .nav__lang a.is-active {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
  }

  .nav__contact {
    font-family: var(--f-display);
    font-style: italic;
    font-size: 1.08rem;
    color: var(--fg);
    text-decoration: none;
  }

  .nav__menu {
    position: relative;
    z-index: 300;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.9rem;
    border: 0;
    border-radius: 2px;
    background: var(--fg);
    color: var(--bg);
    font-family: var(--f-grot);
    font-size: 0.7rem;
    font-weight: 600;
    font-stretch: 90%;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.5s var(--ease-expo);
  }

  .nav__menu i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    transition: scale 0.6s var(--ease-expo);
  }

  .nav__menu:hover { background: var(--accent); }
  .nav__menu:hover i { background: var(--bg); scale: 1.4; }

  .nav__menu-close { display: none; }
  .nav__menu[aria-expanded='true'] .nav__menu-open { display: none; }
  .nav__menu[aria-expanded='true'] .nav__menu-close { display: inline; }

  /* ────────────────────────────────────────
     ÍNDICE (collage a pantalla completa)
  ──────────────────────────────────────── */
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 150;
    overflow: hidden;
    background: var(--papel);
    color: var(--tinta);
    clip-path: circle(0% at calc(100% - var(--gutter) - 40px) 36px);
    visibility: hidden;
    transition:
      clip-path 1s var(--ease-expo),
      visibility 0s linear 1s;
  }

  .overlay.is-open {
    clip-path: circle(150% at calc(100% - var(--gutter) - 40px) 36px);
    visibility: visible;
    transition: clip-path 1.1s var(--ease-expo);
  }

  .overlay__marks > div {
    position: absolute;
    pointer-events: none;
  }

  .overlay__ocre { left: 58%; top: -6%; width: 46vw; opacity: 0.9; rotate: -6deg; }
  .overlay__agua { left: 2%; top: 60%; width: 22vw; opacity: 0.85; }
  .overlay__horse { right: 6%; top: 20%; width: 17vw; rotate: 5deg; }
  .overlay__dog { right: 10%; bottom: 10%; width: 20vw; }

  .overlay__links { list-style: none; }

  .overlay__item {
    position: absolute;
    opacity: 0;
    translate: 0 40px;
    rotate: 3deg;
    transition:
      translate 1s var(--ease-expo),
      rotate 1s var(--ease-expo),
      opacity 0.6s ease;
  }

  .overlay.is-open .overlay__item {
    opacity: 1;
    translate: 0 0;
    rotate: 0deg;
    transition-delay: calc(var(--i) * 70ms + 200ms);
  }

  .overlay__item--0 { left: 6%; top: 15%; font-size: 8.5vw; }
  .overlay__item--1 { left: 34%; top: 27%; font-size: 11vw; font-style: italic; }
  .overlay__item--2 { left: 9%; top: 47%; font-size: 7.5vw; }
  .overlay__item--3 { left: 47%; top: 55%; font-size: 9.5vw; }
  .overlay__item--4 { left: 16%; top: 72%; font-size: 8.5vw; font-style: italic; }

  .overlay__link {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.12em;
    color: var(--tinta);
    text-decoration: none;
  }

  .overlay__num {
    font-family: var(--f-mono);
    font-size: max(0.75rem, 0.12em);
    font-style: normal;
    color: var(--grafito);
    padding-top: 0.5em;
  }

  .overlay__label {
    font-family: var(--f-display);
    line-height: 0.95;
    letter-spacing: -0.035em;
    transition: color 0.3s ease;
  }

  .overlay__link:hover .overlay__label,
  .overlay__link[aria-current='page'] .overlay__label { color: var(--rojo); }

  .overlay__foot {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 1.6rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-family: var(--f-mono);
    font-size: 0.76rem;
    color: var(--grafito);
  }

  .overlay__lang a { color: var(--grafito); }
  .overlay__lang a.is-active { color: var(--tinta); text-decoration-color: var(--rojo); }

  /* ────────────────────────────────────────
     RESPONSIVE
  ──────────────────────────────────────── */
  @media (max-width: 900px) {
    .nav > .nav__right > .nav__lang,
    .nav__contact { display: none; }

    .overlay__item--0 { left: 0; top: 14%; font-size: 15vw; }
    .overlay__item--1 { left: 22%; top: 26%; font-size: 19vw; }
    .overlay__item--2 { left: 4%; top: 42%; font-size: 14vw; }
    .overlay__item--3 { left: 30%; top: 54%; font-size: 17vw; }
    .overlay__item--4 { left: 6%; top: 67%; font-size: 15vw; }
    .overlay__item { padding-left: var(--gutter); }
    .overlay__horse { right: 4%; top: 72%; width: 34vw; }
    .overlay__dog { display: none; }
    .overlay__ocre { width: 110vw; left: 10%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav,
    .overlay,
    .overlay__item { transition: none; }
  }
</style>

<script>
  /* ── Scroll: papel al bajar, se esconde y regresa ── */
  /* Re-consulta #navbar en cada evento: sobrevive a las View Transitions. */
  let lastY = window.scrollY;
  let ticking = false;

  function updateNav() {
    ticking = false;
    const nav = document.getElementById('navbar');
    if (!nav) return;
    const y = window.scrollY;
    const menuOpen = nav.classList.contains('is-open');
    nav.classList.toggle('is-scrolled', y > 24);
    if (!menuOpen && y > 220 && y > lastY + 4) nav.classList.add('is-hidden');
    else if (y < lastY - 4 || y <= 220) nav.classList.remove('is-hidden');
    lastY = y;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(updateNav);
    }
  }, { passive: true });

  /* ── Índice a pantalla completa ─────────────────── */
  /* El DOM se reemplaza en cada View Transition: enlazar en cada
     `astro:page-load` (con guardia contra doble enlace). */
  function setMenu(open: boolean) {
    const btn = document.getElementById('menu-btn');
    const overlay = document.getElementById('mobile-overlay') as HTMLElement | null;
    const nav = document.getElementById('navbar');
    if (!btn || !overlay) return;
    btn.setAttribute('aria-expanded', String(open));
    overlay.classList.toggle('is-open', open);
    overlay.setAttribute('aria-hidden', String(!open));
    overlay.inert = !open;
    nav?.classList.toggle('is-open', open);
    if (open) nav?.classList.remove('is-hidden');
    const lenis = (window as any).__lenis;
    if (lenis) open ? lenis.stop() : lenis.start();
    else document.body.style.overflow = open ? 'hidden' : '';
  }

  function initNavbarMenu() {
    updateNav();
    const btn = document.getElementById('menu-btn') as HTMLButtonElement | null;
    const overlay = document.getElementById('mobile-overlay');
    if (!btn || !overlay || btn.dataset.bound === 'true') return;
    btn.dataset.bound = 'true';
    btn.addEventListener('click', () => setMenu(btn.getAttribute('aria-expanded') !== 'true'));
    overlay.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  }

  /* Escape cierra el índice (un solo listener global). */
  document.addEventListener('keydown', (e) => {
    const btn = document.getElementById('menu-btn');
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      btn.focus();
    }
  });

  initNavbarMenu();
  document.addEventListener('astro:page-load', initNavbarMenu);
  document.addEventListener('astro:before-swap', () => {
    document.body.style.overflow = '';
    (window as any).__lenis?.start();
  });
</script>
