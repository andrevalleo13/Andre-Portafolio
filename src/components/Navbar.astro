---
/**
 * ── Navbar Component ──────────────────────────────────
 *
 * Fixed. Transparent over hero → opaque on scroll.
 * Desktop:  LEFT nav links  |  RIGHT: EN / ES toggle
 * Mobile:   Hamburger → Full-screen overlay (Stealth Wealth)
 *
 * Aesthetic: raw Helvetica Neue, no borders, no decoration.
 * The type IS the design. Animación editorial expo.out.
 */
import { navItems, languages, type Lang } from '../i18n/ui';
import { getLangFromUrl, useTranslations, getLocalePath, getAlternateLangPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const alternate = getAlternateLangPath(Astro.url.pathname);

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/es' || Astro.url.pathname === '/es/';
---

<nav class="navbar" id="navbar">

  <!-- Mobile: Hamburger Button (izquierda) -->
  <button class="navbar__burger" id="menu-btn" aria-label="Toggle Menu" aria-expanded="false">
    <span class="burger__line burger__line--top"></span>
    <span class="burger__line burger__line--mid"></span>
    <span class="burger__line burger__line--bot"></span>
  </button>

  <!-- Desktop: Left page links -->
  <ul class="navbar__links" id="nav-links">
    {!isHome && (
      <li>
        <a href={getLocalePath('/', lang)} class="navbar__link hover-fill" id="nav-home">
          {lang === 'es' ? 'INICIO' : 'HOME'}
        </a>
      </li>
    )}
    {navItems.map((item) => (
      <li>
        <a
          href={getLocalePath(item.href, lang)}
          class:list={[
            'navbar__link',
            item.id === 'contact' ? 'navbar__contact-btn' : 'hover-fill'
          ]}
          id={`nav-${item.id}`}
        >
          {t(`nav.${item.id}` as any)}
          {item.id === 'contact' && (
            <svg class="contact-arrow" width="8" height="8" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0.5 7.5L7.5 0.5M7.5 0.5H1.5M7.5 0.5V6.5" stroke="currentColor" stroke-width="0.8"/>
            </svg>
          )}
        </a>
      </li>
    ))}
  </ul>

  <!-- Right: language switch -->
  <div class="navbar__lang" id="navbar-lang">
    {Object.entries(languages).map(([code, label]) => {
      const isActive = code === lang;
      const href = code === alternate.lang
        ? alternate.href
        : Astro.url.pathname;
      return (
        <a
          href={href}
          class:list={['lang-link hover-fill', { active: isActive }]}
          id={`lang-${code}`}
        >
          {label}
        </a>
      );
    })}
  </div>

</nav>

<!-- Mobile full-screen overlay -->
<div class="mobile-overlay" id="mobile-overlay" aria-hidden="true">
  <div class="overlay__divider"></div>

  <ul class="overlay__links" id="overlay-links">
    {!isHome && (
      <li class="overlay__item">
        <a href={getLocalePath('/', lang)} class="overlay__link" id="overlay-home">
          <span class="overlay__index">00</span>
          <span class="overlay__label">{lang === 'es' ? 'Inicio' : 'Home'}</span>
        </a>
      </li>
    )}
    {navItems.map((item, i) => (
      <li class="overlay__item">
        <a
          href={getLocalePath(item.href, lang)}
          class:list={['overlay__link', item.id === 'contact' && 'overlay__link--contact']}
          id={`overlay-${item.id}`}
        >
          <span class="overlay__index">0{i + 1}</span>
          <span class="overlay__label">{t(`nav.${item.id}` as any)}</span>
          {item.id === 'contact' && (
            <svg class="overlay__arrow" width="10" height="10" viewBox="0 0 8 8" fill="none">
              <path d="M0.5 7.5L7.5 0.5M7.5 0.5H1.5M7.5 0.5V6.5" stroke="currentColor" stroke-width="0.8"/>
            </svg>
          )}
        </a>
      </li>
    ))}
  </ul>

  <!-- Lang switch slides here from navbar via JS -->
  <div class="overlay__lang-slot" id="overlay-lang-slot"></div>
</div>

<style>
  /* ────────────────────────────────────────
     DESKTOP NAV
  ──────────────────────────────────────── */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 200;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2rem 12vw;
    background: transparent;
    transition: background 0.5s ease, backdrop-filter 0.5s ease, padding 0.4s ease;
  }

  .navbar.scrolled {
    background: rgba(20, 17, 15, 0.75);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    padding: 1.25rem 12vw;
  }

  .navbar__links {
    list-style: none;
    display: flex;
    gap: 2px;
  }

  .navbar__link {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.62rem;
    font-weight: 300;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(237, 233, 228, 0.5);
    padding: 0.5rem 1.2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .navbar__contact-btn {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    color: #14110F;
    background: rgba(237, 233, 228, 0.95);
    border-radius: 2px;
    padding: 0.5rem 1.2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    transition: background 0.4s ease;
  }

  .navbar__contact-btn:hover { background: #FFFFFF; }

  .contact-arrow {
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .navbar__contact-btn:hover .contact-arrow {
    transform: translate(3px, -3px);
  }

  .navbar__lang {
    display: flex;
    gap: 2px;
    align-items: center;
  }

  .lang-link {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.62rem;
    font-weight: 300;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(237, 233, 228, 0.35);
    padding: 0.5rem 1.2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .lang-link.active {
    color: rgba(237, 233, 228, 0.95);
    font-weight: 400;
  }

  /* ── Hamburger ─────────────────────────── */
  .navbar__burger {
    display: none;
    background: none;
    border: none;
    outline: none;
    -webkit-tap-highlight-color: transparent;
    cursor: pointer;
    padding: 0.4rem 0;
    flex-direction: column;
    gap: 5px;
    width: 22px;
    position: relative;
    z-index: 300;
  }

  .burger__line {
    display: block;
    width: 100%;
    height: 1px;
    background: rgba(237, 233, 228, 0.8);
    transform-origin: center;
    transition:
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      opacity   0.3s ease,
      width     0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* X morph cuando está abierto */
  .navbar__burger.is-open .burger__line--top {
    transform: translateY(6px) rotate(45deg);
  }
  .navbar__burger.is-open .burger__line--mid {
    opacity: 0;
    transform: scaleX(0);
  }
  .navbar__burger.is-open .burger__line--bot {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ────────────────────────────────────────
     MOBILE OVERLAY
  ──────────────────────────────────────── */
  .mobile-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 150;
    background: rgba(20, 17, 15, 0.98);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    flex-direction: column;
    padding: 0 12vw;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-overlay.is-open {
    opacity: 1;
    pointer-events: all;
  }

  .overlay__divider {
    height: 1px;
    background: rgba(237, 233, 228, 0.06);
    margin-top: 5.5rem;
    margin-bottom: 2.5rem;
  }

  .overlay__links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    flex: 1;
  }

  .overlay__item {
    border-bottom: 1px solid rgba(237, 233, 228, 0.05);
  }

  .overlay__link {
    display: flex;
    align-items: baseline;
    gap: 1.4rem;
    padding: 1.15rem 0;
    text-decoration: none;
  }

  .overlay__index {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.5rem;
    font-weight: 300;
    letter-spacing: 0.25em;
    color: rgba(237, 233, 228, 0.2);
    flex-shrink: 0;
    transform: translateY(24px);
    opacity: 0;
    transition:
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      opacity   0.5s ease;
  }

  .overlay__label {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: clamp(1.5rem, 7.5vw, 2.2rem);
    font-weight: 200;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: rgba(237, 233, 228, 0.65);
    transform: translateY(32px);
    opacity: 0;
    display: block;
    transition:
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      opacity   0.5s ease,
      color     0.3s ease;
  }

  .overlay__arrow {
    margin-left: 0.4rem;
    flex-shrink: 0;
    color: rgba(237, 233, 228, 0.35);
    transform: translateY(24px);
    opacity: 0;
    align-self: center;
    transition:
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      opacity   0.5s ease;
  }

  /* Stagger por item */
  .overlay__item:nth-child(1) .overlay__index,
  .overlay__item:nth-child(1) .overlay__label,
  .overlay__item:nth-child(1) .overlay__arrow { transition-delay: 0.04s; }

  .overlay__item:nth-child(2) .overlay__index,
  .overlay__item:nth-child(2) .overlay__label,
  .overlay__item:nth-child(2) .overlay__arrow { transition-delay: 0.09s; }

  .overlay__item:nth-child(3) .overlay__index,
  .overlay__item:nth-child(3) .overlay__label,
  .overlay__item:nth-child(3) .overlay__arrow { transition-delay: 0.14s; }

  .overlay__item:nth-child(4) .overlay__index,
  .overlay__item:nth-child(4) .overlay__label,
  .overlay__item:nth-child(4) .overlay__arrow { transition-delay: 0.19s; }

  .overlay__item:nth-child(5) .overlay__index,
  .overlay__item:nth-child(5) .overlay__label,
  .overlay__item:nth-child(5) .overlay__arrow { transition-delay: 0.24s; }

  /* Estado visible */
  .mobile-overlay.is-open .overlay__index,
  .mobile-overlay.is-open .overlay__label,
  .mobile-overlay.is-open .overlay__arrow {
    transform: translateY(0);
    opacity: 1;
  }

  /* Hover */
  .overlay__link:hover .overlay__label { color: rgba(237, 233, 228, 0.95); }
  .overlay__link:hover .overlay__index { color: rgba(237, 233, 228, 0.4); }

  /* Contact destacado */
  .overlay__link--contact .overlay__label {
    color: rgba(237, 233, 228, 0.9);
    font-weight: 300;
  }

  /* Lang slot at bottom of overlay */
  .overlay__lang-slot {
    padding: 2rem 0 3rem;
    transform: translateY(16px);
    opacity: 0;
    transition:
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.28s,
      opacity   0.5s ease 0.28s;
  }

  .mobile-overlay.is-open .overlay__lang-slot {
    transform: translateY(0);
    opacity: 1;
  }

  /* ────────────────────────────────────────
     RESPONSIVE BREAKPOINT
  ──────────────────────────────────────── */
  @media (max-width: 768px) {
    .navbar__burger { display: flex; }
    .navbar__links  { display: none !important; }
    .navbar__lang {
      position: relative;
      z-index: 300;
      transition: opacity 0.3s ease, transform 0.3s ease;
    }
    .navbar__lang.is-hidden {
      opacity: 0;
      pointer-events: none;
      transform: translateY(-4px);
    }
    .mobile-overlay { display: flex; }
  }
</style>

<script>
  /* ── Scroll class ─────────────────────── */
  window.addEventListener('scroll', () => {
    const nav = document.getElementById('navbar');
    if (nav) nav.classList.toggle('scrolled', window.scrollY > 40);
  }, { passive: true });

  /* ── Mobile menu toggle ───────────────── */
  const menuBtn = document.getElementById('menu-btn') as HTMLButtonElement | null;
  const overlay = document.getElementById('mobile-overlay') as HTMLElement | null;
  const navbarLang = document.getElementById('navbar-lang') as HTMLElement | null;
  const overlayLangSlot = document.getElementById('overlay-lang-slot') as HTMLElement | null;

  let isOpen = false;

  function openMenu() {
    if (!menuBtn || !overlay) return;
    isOpen = true;
    menuBtn.classList.add('is-open');
    menuBtn.setAttribute('aria-expanded', 'true');
    overlay.classList.add('is-open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    /* Move lang switch into overlay */
    if (navbarLang && overlayLangSlot) {
      navbarLang.classList.add('is-hidden');
      setTimeout(() => {
        overlayLangSlot.appendChild(navbarLang);
        navbarLang.classList.remove('is-hidden');
      }, 150);
    }
  }

  function closeMenu() {
    if (!menuBtn || !overlay) return;
    isOpen = false;
    menuBtn.classList.remove('is-open');
    menuBtn.setAttribute('aria-expanded', 'false');
    overlay.classList.remove('is-open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    /* Move lang switch back to navbar */
    if (navbarLang && overlayLangSlot) {
      const navbar = document.getElementById('navbar');
      if (navbar) {
        navbar.appendChild(navbarLang);
        navbarLang.classList.remove('is-hidden');
      }
    }
  }

  if (menuBtn && overlay) {
    menuBtn.addEventListener('click', () => isOpen ? closeMenu() : openMenu());
    overlay.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
  }
</script>
