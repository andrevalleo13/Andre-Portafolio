---
/**
 * ── Newsletter ────────────────────────────────────────
 *
 * Cupón de suscripción recortable, como el de un periódico:
 * borde punteado con tijeras, el titular en negra condensada y
 * el campo de email subrayado. Al enviar, alta en POST /api/subscribe.
 */
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="cupon">
  <span class="cupon__tijeras" aria-hidden="true">✂</span>
  <p class="lv-kicker">{lang === 'es' ? 'Cupón de suscripción · Gratis' : 'Subscription coupon · Free'}</p>
  <h3 class="cupon__heading">{t('newsletter.heading')}</h3>
  <form
    class="cupon__form"
    id="newsletter-form"
    data-success={t('newsletter.success')}
    data-error={t('newsletter.error')}
  >
    <label class="lv-sr-only" for="newsletter-email">{t('newsletter.placeholder')}</label>
    <input type="email" id="newsletter-email" placeholder={t('newsletter.placeholder')} class="cupon__input" required />
    <button type="submit" class="lv-btn cupon__btn">
      {t('newsletter.button')}
      <svg width="9" height="9" viewBox="0 0 8 8" fill="none" aria-hidden="true">
        <path d="M0.5 7.5L7.5 0.5M7.5 0.5H1.5M7.5 0.5V6.5" stroke="currentColor" stroke-width="0.9" />
      </svg>
    </button>
  </form>
  <p class="cupon__msg" id="newsletter-msg" hidden></p>
</div>

<script>
  function initNewsletter() {
    const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const input = form.querySelector('input') as HTMLInputElement;
    const btn = form.querySelector('button') as HTMLButtonElement;
    const msg = document.getElementById('newsletter-msg');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      if (!email) return;

      btn.disabled = true;
      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.hidden = true;
        if (msg) {
          msg.textContent = form.dataset.success || 'Subscribed.';
          msg.hidden = false;
        }
      } catch {
        btn.disabled = false;
        if (msg) {
          msg.textContent = form.dataset.error || 'Something went wrong.';
          msg.hidden = false;
        }
      }
    });
  }

  initNewsletter();
  document.addEventListener('astro:page-load', initNewsletter);
</script>

<style>
  .cupon {
    position: relative;
    display: grid;
    gap: 16px;
    max-width: 640px;
    padding: clamp(24px, 3vw, 40px);
    border: 2px dashed var(--tinta);
    background: var(--hoja);
    rotate: -1deg;
  }

  .cupon__tijeras {
    position: absolute;
    top: -0.85em;
    left: 28px;
    padding: 0 6px;
    background: var(--papel);
    font-size: 1.3rem;
    line-height: 1;
    color: var(--rojo);
  }

  .cupon__heading {
    font-family: var(--f-grot);
    font-weight: 900;
    font-stretch: 75%;
    font-size: clamp(2.2rem, 4.6vw, 4.4rem);
    line-height: 0.88;
    text-transform: uppercase;
  }

  .cupon__form {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 16px 20px;
  }

  .cupon__input {
    flex: 1 1 240px;
    min-width: 0;
    padding: 0.5rem 0;
    border: 0;
    border-bottom: 1px solid var(--tinta);
    border-radius: 0;
    outline: none;
    background: transparent;
    color: var(--tinta);
    font-family: var(--f-serif);
    font-style: italic;
    font-size: 1.4rem;
  }

  .cupon__input:focus { border-bottom-color: var(--rojo); }
  .cupon__input::placeholder { color: var(--linea); }

  .cupon__msg {
    font-family: var(--f-serif);
    font-style: italic;
    font-size: 1.2rem;
    color: var(--rojo);
  }
</style>
