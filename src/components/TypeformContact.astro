---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const dict = {
  a: {
    q3: t('typeform.q3.a'),
    opt1: t('typeform.q3.a.opt1'),
    opt2: t('typeform.q3.a.opt2'),
    opt3: t('typeform.q3.a.opt3'),
    q4: t('typeform.q4.a')
  },
  b: {
    q3: t('typeform.q3.b'),
    opt1: t('typeform.q3.b.opt1'),
    opt2: t('typeform.q3.b.opt2'),
    opt3: t('typeform.q3.b.opt3'),
    q4: t('typeform.q4.b')
  },
  c: {
    q3: t('typeform.q3.c'),
    opt1: t('typeform.q3.c.opt1'),
    opt2: t('typeform.q3.c.opt2'),
    opt3: t('typeform.q3.c.opt3'),
    q4: t('typeform.q4.c')
  }
};
---

<div class="typeform-container" id="typeform-app" data-dict={JSON.stringify(dict)}>
  <div class="progress-bar">
    <div class="progress-fill" id="progress-fill"></div>
  </div>

  <div class="steps-wrapper">
    <!-- Step 1: Name -->
    <div class="tf-step active" data-step="1">
      <div class="step-content">
        <label for="tf-name" class="tf-question">1 → {t('typeform.q1')}</label>
        <div class="tf-input-wrapper">
          <input type="text" id="tf-name" class="tf-input" placeholder={t('typeform.q1.placeholder')} autocomplete="off" />
          <span class="tf-hint">{t('typeform.pressEnter')}</span>
        </div>
      </div>
    </div>

    <!-- Step 2: Intent -->
    <div class="tf-step" data-step="2">
      <div class="step-content">
        <label class="tf-question" id="q2-label" data-raw={t('typeform.q2')}>2 → {t('typeform.q2').replace('{name}', '...')}</label>
        <div class="tf-options" id="options-step-2">
          <button class="tf-option" data-value="a">
            <span class="key">A</span>
            <span class="text">{t('typeform.q2.opt1')}</span>
          </button>
          <button class="tf-option" data-value="b">
            <span class="key">B</span>
            <span class="text">{t('typeform.q2.opt2')}</span>
          </button>
          <button class="tf-option" data-value="c">
            <span class="key">C</span>
            <span class="text">{t('typeform.q2.opt3')}</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Step 3: Sub-intent (Dynamic) -->
    <div class="tf-step" data-step="3">
      <div class="step-content">
        <label class="tf-question" id="q3-label">3 → ...</label>
        <div class="tf-options" id="options-step-3">
          <button class="tf-option" data-value="opt1">
            <span class="key">A</span>
            <span class="text" id="q3-opt1">...</span>
          </button>
          <button class="tf-option" data-value="opt2">
            <span class="key">B</span>
            <span class="text" id="q3-opt2">...</span>
          </button>
          <button class="tf-option" data-value="opt3">
            <span class="key">C</span>
            <span class="text" id="q3-opt3">...</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Step 4: Details (Dynamic) -->
    <div class="tf-step" data-step="4">
      <div class="step-content">
        <label for="tf-details" class="tf-question" id="q4-label">4 → ...</label>
        <div class="tf-input-wrapper">
          <textarea id="tf-details" class="tf-input tf-textarea" placeholder={t('typeform.q4.placeholder')} rows="1"></textarea>
          <span class="tf-hint">{t('typeform.pressEnter')}</span>
        </div>
      </div>
    </div>

    <!-- Step 5: Email -->
    <div class="tf-step" data-step="5">
      <div class="step-content">
        <label for="tf-email" class="tf-question">5 → {t('typeform.q5')}</label>
        <div class="tf-input-wrapper">
          <input type="email" id="tf-email" class="tf-input" placeholder={t('typeform.q5.placeholder')} autocomplete="off" />
          <button id="tf-submit" class="tf-submit">{t('typeform.submit')}</button>
        </div>
      </div>
    </div>

    <!-- Step 6: Success -->
    <div class="tf-step" data-step="6">
      <div class="step-content success-content">
        <h2 class="tf-success">{t('typeform.success')}</h2>
      </div>
    </div>
  </div>

  <div class="tf-controls">
    <button id="tf-up" class="tf-nav-btn" disabled>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 15l-6-6-6 6"/></svg>
    </button>
    <button id="tf-down" class="tf-nav-btn">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9l6 6 6-6"/></svg>
    </button>
  </div>
</div>

<style>
  .typeform-container {
    position: relative;
    width: 100%;
    height: 100vh;
    background-color: var(--dark);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: background-color 2s ease;
  }

  /* Dynamic Themes */
  .typeform-container.theme-a { background-color: #101318; }
  .typeform-container.theme-b { background-color: #131714; }
  .typeform-container.theme-c { background-color: #1c1715; }

  /* Dimming */
  .typeform-container.tf-is-focused .progress-bar,
  .typeform-container.tf-is-focused .tf-controls,
  .typeform-container.tf-is-focused .tf-question {
    opacity: 0.2;
  }

  .progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: rgba(237, 233, 228, 0.1);
    z-index: 100;
    transition: opacity 0.5s ease;
  }

  .progress-fill {
    height: 100%;
    width: 0%;
    background-color: var(--bone-light);
    transition: width 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .steps-wrapper {
    position: relative;
    flex-grow: 1;
    width: 100%;
    height: 100%;
  }

  .tf-step {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 10vw;
    opacity: 0;
    pointer-events: none;
    transform: translateY(50px);
  }

  .tf-step.active {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .step-content {
    width: 100%;
    max-width: 800px;
  }

  .tf-question {
    display: block;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    color: var(--bone-light);
    margin-bottom: 3rem;
    line-height: 1.3;
    transition: opacity 0.5s ease;
  }

  .tf-input-wrapper {
    position: relative;
    width: 100%;
  }

  .tf-input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 2px solid rgba(237, 233, 228, 0.2);
    color: var(--bone-light);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 300;
    font-family: inherit;
    padding: 0.5rem 0;
    outline: none;
    transition: border-color 0.3s ease;
  }

  .tf-input:focus {
    border-bottom-color: var(--bone-light);
  }

  .tf-input::placeholder {
    color: rgba(237, 233, 228, 0.2);
  }

  .tf-textarea {
    resize: none;
    overflow: hidden;
    min-height: 2em;
  }

  .tf-hint {
    position: absolute;
    right: 0;
    bottom: -2rem;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(237, 233, 228, 0.4);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .tf-input:focus + .tf-hint {
    opacity: 1;
  }

  /* Options Grid */
  .tf-options {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .tf-option {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    background: transparent;
    border: none;
    padding: 0.5rem 0;
    color: rgba(237, 233, 228, 0.5);
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    font-family: inherit;
    font-weight: 300;
    cursor: pointer;
    text-align: left;
    transition: all 0.3s ease;
  }

  .tf-option:hover, .tf-option.selected {
    color: var(--bone-light);
    transform: translateX(10px);
  }

  .tf-option .key {
    font-size: 0.8rem;
    color: rgba(237, 233, 228, 0.4);
    font-family: monospace;
    transition: color 0.3s ease;
  }
  
  .tf-option:hover .key, .tf-option.selected .key {
    color: var(--bone-light);
  }

  /* Submit Button */
  .tf-submit {
    margin-top: 3rem;
    background: transparent;
    color: var(--bone-light);
    border: 1px solid var(--bone-light);
    padding: 0.8rem 2rem;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.7rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    border-radius: 2px;
    cursor: pointer;
    transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease, width 0.3s ease;
    display: none;
    transform-origin: center;
    text-align: center;
  }

  .tf-step[data-step="5"].active .tf-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .tf-submit:hover:not(.loading) {
    background: var(--bone-light);
    color: var(--dark);
    transform: translateY(-2px);
  }

  .tf-submit.loading {
    width: 40px;
    height: 40px;
    padding: 0;
    color: transparent;
    border-radius: 50%;
    border-color: rgba(237, 233, 228, 0.2);
    border-top-color: var(--bone-light);
    background: transparent;
    animation: tf-spin 1s linear infinite;
    pointer-events: none;
  }

  @keyframes tf-spin {
    to { transform: rotate(360deg); }
  }

  /* Success Message */
  .tf-success {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 200;
    color: var(--bone-light);
    text-align: center;
  }

  /* Controls */
  .tf-controls {
    position: absolute;
    bottom: 3rem;
    right: 5vw;
    display: flex;
    gap: 0.5rem;
    z-index: 100;
    transition: opacity 0.5s ease;
  }

  .tf-nav-btn {
    width: 40px;
    height: 40px;
    background: rgba(237, 233, 228, 0.05);
    border: none;
    color: var(--bone-light);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 2px;
    transition: background 0.3s ease;
  }

  .tf-nav-btn:hover:not(:disabled) {
    background: rgba(237, 233, 228, 0.15);
  }

  .tf-nav-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  @media (max-width: 768px) {
    .tf-question { margin-bottom: 2rem; }
    .tf-option { font-size: 1rem; padding: 0.75rem 1rem; }
    .tf-controls { right: 2vw; bottom: 2rem; }
  }
</style>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('astro:page-load', () => {
    const container = document.getElementById('typeform-app');
    if (!container) return;

    const dictRaw = container.getAttribute('data-dict') || '{}';
    let dict: Record<string, any> = {};
    try { dict = JSON.parse(dictRaw); } catch(e) {}

    const STORAGE_KEY = 'andrevalle_typeform_state';

    let currentStep = 1;
    const totalSteps = 5; // Step 6 is success
    const state = {
      name: '',
      intent: '', // 'a', 'b', or 'c'
      subIntent: '',
      details: '',
      email: ''
    };

    const steps = Array.from(document.querySelectorAll('.tf-step'));
    const btnUp = document.getElementById('tf-up');
    const btnDown = document.getElementById('tf-down');
    const progressFill = document.getElementById('progress-fill');
    
    // Inputs & Labels
    const inputName = document.getElementById('tf-name') as HTMLInputElement;
    const q2Label = document.getElementById('q2-label');
    const q3Label = document.getElementById('q3-label');
    const q3Opt1 = document.getElementById('q3-opt1');
    const q3Opt2 = document.getElementById('q3-opt2');
    const q3Opt3 = document.getElementById('q3-opt3');
    const q4Label = document.getElementById('q4-label');

    const optsStep2 = document.querySelectorAll('#options-step-2 .tf-option');
    const optsStep3 = document.querySelectorAll('#options-step-3 .tf-option');
    const inputDetails = document.getElementById('tf-details') as HTMLTextAreaElement;
    const inputEmail = document.getElementById('tf-email') as HTMLInputElement;
    const btnSubmit = document.getElementById('tf-submit');

    // 1. LocalStorage Logic
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      try {
        const parsed = JSON.parse(saved);
        if (parsed.step && parsed.step <= totalSteps) {
          currentStep = parsed.step;
          state.name = parsed.state.name || '';
          state.intent = parsed.state.intent || '';
          state.subIntent = parsed.state.subIntent || '';
          state.details = parsed.state.details || '';
          state.email = parsed.state.email || '';
          
          if(inputName) inputName.value = state.name;
          if(inputDetails) inputDetails.value = state.details;
          if(inputEmail) inputEmail.value = state.email;
          
          if (state.intent) {
            const opt = document.querySelector(`#options-step-2 .tf-option[data-value="${state.intent}"]`);
            if (opt) opt.classList.add('selected');
            applyTheme(state.intent);
            populateDynamicTexts();
          }
          if (state.subIntent) {
            const opt = document.querySelector(`#options-step-3 .tf-option[data-value="${state.subIntent}"]`);
            if (opt) opt.classList.add('selected');
          }
        }
      } catch(e) {}
    }

    function saveState() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({
        step: currentStep,
        state: state
      }));
    }

    function applyTheme(intent: string) {
      container?.classList.remove('theme-a', 'theme-b', 'theme-c');
      if (intent) container?.classList.add(`theme-${intent}`);
    }

    function populateDynamicTexts() {
      if (!state.intent || !dict[state.intent]) return;
      const tData = dict[state.intent];
      if (q3Label) q3Label.textContent = `3 → ${tData.q3}`;
      if (q3Opt1) q3Opt1.textContent = tData.opt1;
      if (q3Opt2) q3Opt2.textContent = tData.opt2;
      if (q3Opt3) q3Opt3.textContent = tData.opt3;
      if (q4Label) q4Label.textContent = `4 → ${tData.q4}`;
    }

    // 2. Cinematic Focus Dimming
    function handleFocus() {
      container?.classList.add('tf-is-focused');
      const nav = document.querySelector('.navbar') as HTMLElement;
      if (nav) {
        nav.style.transition = 'opacity 0.5s ease';
        nav.style.opacity = '0.1';
      }
    }
    
    function handleBlur() {
      container?.classList.remove('tf-is-focused');
      const nav = document.querySelector('.navbar') as HTMLElement;
      if (nav) nav.style.opacity = '1';
    }

    document.querySelectorAll('.tf-input').forEach(input => {
      input.addEventListener('focus', handleFocus);
      input.addEventListener('blur', handleBlur);
      input.addEventListener('input', () => {
        if(input === inputName) state.name = inputName.value;
        if(input === inputDetails) state.details = inputDetails.value;
        if(input === inputEmail) state.email = inputEmail.value;
        saveState();
      });
    });

    // Init display
    updateDisplay();

    function updateDisplay(dir = 1) {
      saveState();

      if (progressFill) {
        progressFill.style.width = `${((currentStep - 1) / totalSteps) * 100}%`;
      }

      if (btnUp) (btnUp as HTMLButtonElement).disabled = currentStep === 1 || currentStep > totalSteps;
      if (btnDown) (btnDown as HTMLButtonElement).disabled = currentStep >= totalSteps;

      steps.forEach((step) => {
        const stepNum = parseInt(step.getAttribute('data-step') || '1');
        if (stepNum === currentStep) {
          step.classList.add('active');
          gsap.fromTo(step, 
            { y: dir > 0 ? 50 : -50, opacity: 0 }, 
            { y: 0, opacity: 1, duration: 0.8, ease: "power3.out", delay: 0.2 }
          );
          
          setTimeout(() => {
            const input = step.querySelector('input, textarea') as HTMLElement;
            if (input) input.focus();
          }, 800);
          
        } else {
          if (step.classList.contains('active')) {
            gsap.to(step, {
              y: dir > 0 ? -50 : 50, 
              opacity: 0, 
              duration: 0.5, 
              ease: "power2.in",
              onComplete: () => step.classList.remove('active')
            });
          }
        }
      });

      if (currentStep === 2 && q2Label) {
        const rawText = q2Label.getAttribute('data-raw') || '';
        const nameToUse = state.name.trim() ? state.name.trim().split(' ')[0] : 'friend';
        q2Label.textContent = `2 → ${rawText.replace('{name}', nameToUse)}`;
      }
    }

    function nextStep() {
      if (currentStep > totalSteps) return;
      if (currentStep === 1 && !state.name.trim()) return;
      if (currentStep === 2 && !state.intent) return;
      if (currentStep === 3 && !state.subIntent) return;

      currentStep++;
      updateDisplay(1);
    }

    function prevStep() {
      if (currentStep <= 1 || currentStep > totalSteps) return;
      currentStep--;
      updateDisplay(-1);
    }

    if (btnUp) btnUp.addEventListener('click', prevStep);
    if (btnDown) btnDown.addEventListener('click', nextStep);

    [inputName, inputDetails, inputEmail].forEach(input => {
      if (!input) return;
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          if (input === inputEmail && btnSubmit) {
            btnSubmit.click();
          } else {
            nextStep();
          }
        }
      });
    });

    if (inputDetails) {
      inputDetails.addEventListener('input', function() {
        this.style.height = 'auto';
        this.style.height = (this.scrollHeight) + 'px';
      });
    }

    // Step 2 Options
    optsStep2.forEach(opt => {
      opt.addEventListener('click', function() {
        optsStep2.forEach(o => o.classList.remove('selected'));
        opt.classList.add('selected');
        state.intent = opt.getAttribute('data-value') || '';
        applyTheme(state.intent);
        populateDynamicTexts();
        saveState();
        setTimeout(nextStep, 400);
      });
    });

    // Step 3 Options
    optsStep3.forEach(opt => {
      opt.addEventListener('click', function() {
        optsStep3.forEach(o => o.classList.remove('selected'));
        opt.classList.add('selected');
        state.subIntent = opt.getAttribute('data-value') || '';
        saveState();
        setTimeout(nextStep, 400);
      });
    });

    // Keyboard shortcuts (A, B, C) mapped to active step
    document.addEventListener('keydown', (e) => {
      if (currentStep !== 2 && currentStep !== 3) return;
      const key = e.key.toLowerCase();
      
      const activeOpts = currentStep === 2 ? optsStep2 : optsStep3;
      let selectedOpt = null;
      
      if (key === 'a') selectedOpt = activeOpts[0];
      if (key === 'b') selectedOpt = activeOpts[1];
      if (key === 'c') selectedOpt = activeOpts[2];
      
      if (selectedOpt) {
        (selectedOpt as HTMLElement).click();
      }
    });

    // Submit
    if (btnSubmit) {
      btnSubmit.addEventListener('click', () => {
        state.email = inputEmail.value;
        if (!state.email.trim() || !state.email.includes('@')) return;
        
        btnSubmit.classList.add('loading');
        
        setTimeout(() => {
          currentStep = 6; // Success step
          if (progressFill) progressFill.style.width = '100%';
          localStorage.removeItem(STORAGE_KEY);
          updateDisplay(1);
          console.log('Form Submitted with Branching:', state);
        }, 1500);
      });
    }
  });
</script>
