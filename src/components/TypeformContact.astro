---
/**
 * ── TypeformContact ───────────────────────────────────
 *
 * Formulario de contacto paso a paso (tipo Typeform), estética
 * "Lujo vivido". Misma lógica de siempre:
 *   1 nombre → 2 intención (A/B/C) → 3 sub-intención (según la rama)
 *   → 4 detalles → 5 email → envío a POST /api/contact → 6 recibido.
 * Guarda el avance en localStorage y acepta teclado (Enter, A/B/C).
 *
 * A la izquierda: el paso en Hubot negra, la numeración tipo
 * Margiela y un dibujo que cambia con la intención elegida
 * (a: lobo · b: velero · c: dálmata).
 */
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import Lobo from './art/Lobo.astro';
import Velero from './art/Velero.astro';
import Dalmata from './art/Dalmata.astro';
import CaballoAcuarela from './art/CaballoAcuarela.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const dict = {
  a: {
    q3: t('typeform.q3.a'),
    opt1: t('typeform.q3.a.opt1'),
    opt2: t('typeform.q3.a.opt2'),
    opt3: t('typeform.q3.a.opt3'),
    q4: t('typeform.q4.a')
  },
  b: {
    q3: t('typeform.q3.b'),
    opt1: t('typeform.q3.b.opt1'),
    opt2: t('typeform.q3.b.opt2'),
    opt3: t('typeform.q3.b.opt3'),
    q4: t('typeform.q4.b')
  },
  c: {
    q3: t('typeform.q3.c'),
    opt1: t('typeform.q3.c.opt1'),
    opt2: t('typeform.q3.c.opt2'),
    opt3: t('typeform.q3.c.opt3'),
    q4: t('typeform.q4.c')
  }
};
---

<div
  class="tf"
  id="typeform-app"
  data-dict={JSON.stringify(dict)}
  data-error={t('typeform.error')}
>
  <div class="progress-bar" aria-hidden="true">
    <div class="progress-fill" id="progress-fill"></div>
  </div>

  <aside class="tf__side">
    <p class="lv-kicker">Nº V — {t('nav.contact')}</p>
    <p class="tf__count" aria-live="polite"><b id="tf-count">01</b><span>/05</span></p>
    <ol class="tf__nums" id="tf-nums" aria-hidden="true">
      {[1, 2, 3, 4, 5].map((n) => <li data-n={n}>{n}</li>)}
    </ol>
    <div class="tf__art" aria-hidden="true">
      <div class="tf__art-item is-default"><CaballoAcuarela draw="none" /></div>
      <div class="tf__art-item" data-art="a"><Lobo draw="none" /></div>
      <div class="tf__art-item" data-art="b"><Velero draw="none" /></div>
      <div class="tf__art-item" data-art="c"><Dalmata draw="none" /></div>
    </div>
  </aside>

  <div class="steps-wrapper">
    <!-- Step 1: Name -->
    <div class="tf-step active" data-step="1">
      <div class="step-content">
        <label for="tf-name" class="tf-question">{t('typeform.q1')}</label>
        <div class="tf-input-wrapper">
          <input type="text" id="tf-name" class="tf-input" placeholder={t('typeform.q1.placeholder')} autocomplete="off" />
          <span class="tf-hint">{t('typeform.pressEnter')}</span>
        </div>
      </div>
    </div>

    <!-- Step 2: Intent -->
    <div class="tf-step" data-step="2">
      <div class="step-content">
        <p class="tf-question" id="q2-label" data-raw={t('typeform.q2')}>{t('typeform.q2').replace('{name}', '...')}</p>
        <div class="tf-options" id="options-step-2">
          <button class="tf-option" data-value="a" type="button">
            <span class="key">A</span>
            <span class="text">{t('typeform.q2.opt1')}</span>
          </button>
          <button class="tf-option" data-value="b" type="button">
            <span class="key">B</span>
            <span class="text">{t('typeform.q2.opt2')}</span>
          </button>
          <button class="tf-option" data-value="c" type="button">
            <span class="key">C</span>
            <span class="text">{t('typeform.q2.opt3')}</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Step 3: Sub-intent (Dynamic) -->
    <div class="tf-step" data-step="3">
      <div class="step-content">
        <p class="tf-question" id="q3-label">...</p>
        <div class="tf-options" id="options-step-3">
          <button class="tf-option" data-value="opt1" type="button">
            <span class="key">A</span>
            <span class="text" id="q3-opt1">...</span>
          </button>
          <button class="tf-option" data-value="opt2" type="button">
            <span class="key">B</span>
            <span class="text" id="q3-opt2">...</span>
          </button>
          <button class="tf-option" data-value="opt3" type="button">
            <span class="key">C</span>
            <span class="text" id="q3-opt3">...</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Step 4: Details (Dynamic) -->
    <div class="tf-step" data-step="4">
      <div class="step-content">
        <label for="tf-details" class="tf-question" id="q4-label">...</label>
        <div class="tf-input-wrapper">
          <textarea id="tf-details" class="tf-input tf-textarea" placeholder={t('typeform.q4.placeholder')} rows="1"></textarea>
          <span class="tf-hint">{t('typeform.pressEnter')}</span>
        </div>
      </div>
    </div>

    <!-- Step 5: Email -->
    <div class="tf-step" data-step="5">
      <div class="step-content">
        <label for="tf-email" class="tf-question">{t('typeform.q5')}</label>
        <div class="tf-input-wrapper">
          <input type="email" id="tf-email" class="tf-input" placeholder={t('typeform.q5.placeholder')} autocomplete="off" />
        </div>
        <button id="tf-submit" class="tf-submit" type="button">{t('typeform.submit')} →</button>
        <p class="tf-error" id="tf-error" hidden></p>
      </div>
    </div>

    <!-- Step 6: Success -->
    <div class="tf-step" data-step="6">
      <div class="step-content success-content">
        <p class="tf-success-mark">{lang === 'es' ? 'Recibido.' : 'Received.'}</p>
        <h2 class="tf-success">{t('typeform.success')}</h2>
      </div>
    </div>
  </div>

  <div class="tf-controls">
    <button id="tf-up" class="tf-nav-btn" type="button" aria-label="↑" disabled>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M18 15l-6-6-6 6"/></svg>
    </button>
    <button id="tf-down" class="tf-nav-btn" type="button" aria-label="↓">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 9l6 6 6-6"/></svg>
    </button>
  </div>
</div>

<style>
  .tf {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
    min-height: 100svh;
    overflow: hidden;
    background: var(--papel);
    color: var(--tinta);
  }

  /* Al escribir, todo lo demás se atenúa */
  .tf.tf-is-focused .tf__side,
  .tf.tf-is-focused .tf-controls { opacity: 0.55; }

  .progress-bar {
    position: absolute;
    inset: 0 0 auto;
    z-index: 100;
    height: 2px;
    background: var(--linea);
  }

  .progress-fill {
    width: 0%;
    height: 100%;
    background: var(--rojo);
    transition: width 0.8s var(--ease-expo);
  }

  /* ── Columna izquierda ── */
  .tf__side {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: clamp(110px, 16vh, 160px) 0 48px var(--gutter);
    transition: opacity 0.5s ease;
  }

  .tf__count {
    display: flex;
    align-items: baseline;
    font-family: var(--f-grot);
    font-weight: 900;
    font-stretch: 75%;
    line-height: 0.8;
    letter-spacing: -0.03em;
  }

  .tf__count b { font-size: clamp(6rem, 13vw, 13rem); font-weight: 900; }
  .tf__count span { font-size: clamp(1.6rem, 2.6vw, 2.6rem); color: var(--grafito); margin-left: 0.2em; }

  .tf__nums {
    list-style: none;
    display: flex;
    gap: 14px;
    font-family: var(--f-grot);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--grafito);
  }

  .tf__nums li { position: relative; width: 1.2em; text-align: center; transition: color 0.3s ease; }
  .tf__nums li.is-done { color: var(--tinta); }
  .tf__nums li.is-current { color: var(--rojo); }

  .tf__nums li.is-current::after {
    content: '';
    position: absolute;
    inset: -6px -8px;
    border: 1.5px solid var(--rojo);
    border-radius: 50%;
    rotate: -8deg;
  }

  .tf__art {
    position: relative;
    margin-top: auto;
    width: min(26vw, 320px);
    aspect-ratio: 360 / 280;
  }

  .tf__art-item {
    position: absolute;
    inset: 0;
    display: grid;
    align-items: end;
    color: var(--tinta);
    opacity: 0;
    translate: 0 24px;
    rotate: -4deg;
    transition: opacity 0.6s ease, translate 0.9s var(--ease-expo), rotate 0.9s var(--ease-expo);
  }

  .tf:not(.theme-a):not(.theme-b):not(.theme-c) .tf__art-item.is-default,
  .tf.theme-a [data-art='a'],
  .tf.theme-b [data-art='b'],
  .tf.theme-c [data-art='c'] {
    opacity: 1;
    translate: 0 0;
    rotate: 0deg;
  }

  .tf__art-item.is-default { width: 92%; }

  /* ── Pasos ── */
  .steps-wrapper {
    position: relative;
    min-height: 100svh;
  }

  .tf-step {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    padding: 0 var(--gutter) 0 4vw;
    opacity: 0;
    pointer-events: none;
    transform: translateY(50px);
  }

  .tf-step.active {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .step-content { width: 100%; max-width: 820px; }

  .tf-question {
    display: block;
    margin-bottom: 2.6rem;
    font-family: var(--f-serif);
    font-size: clamp(1.9rem, 3.6vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
    transition: opacity 0.5s ease;
  }

  /* Línea del input: tinta, y al escribir la pluma roja la recorre */
  .tf-input-wrapper {
    position: relative;
    width: 100%;
  }

  .tf-input-wrapper::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: var(--rojo);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.9s var(--ease-expo);
  }

  .tf-input-wrapper:focus-within::after { transform: scaleX(1); }

  .tf-input {
    width: 100%;
    padding: 0.4rem 0;
    border: 0;
    border-bottom: 1px solid var(--tinta);
    border-radius: 0;
    outline: none;
    background: transparent;
    color: var(--tinta);
    font-family: var(--f-serif);
    font-style: italic;
    font-size: clamp(1.6rem, 3vw, 2.8rem);
  }

  .tf-input::placeholder { color: var(--linea); }

  .tf-textarea {
    resize: none;
    overflow: hidden;
    min-height: 1.6em;
  }

  .tf-hint {
    position: absolute;
    right: 0;
    bottom: -2rem;
    font-family: var(--f-grot);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--grafito);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .tf-input:focus + .tf-hint { opacity: 1; }

  /* ── Opciones ── */
  .tf-options {
    display: grid;
    border-top: 1px solid var(--linea);
  }

  .tf-option {
    display: flex;
    align-items: center;
    gap: 1.3rem;
    padding: 1.05rem 0;
    border: 0;
    border-bottom: 1px solid var(--linea);
    background: transparent;
    color: var(--tinta);
    font-family: var(--f-serif);
    font-size: clamp(1.15rem, 1.8vw, 1.6rem);
    text-align: left;
    cursor: pointer;
    transition: translate 0.7s var(--ease-expo), color 0.3s ease;
  }

  .tf-option .key {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid var(--tinta);
    font-family: var(--f-grot);
    font-size: 0.78rem;
    font-weight: 700;
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  .tf-option:hover { translate: 12px 0; font-style: italic; }
  .tf-option:hover .key { border-color: var(--rojo); color: var(--rojo); }

  .tf-option.selected { color: var(--rojo); font-style: italic; }
  .tf-option.selected .key { background: var(--rojo); border-color: var(--rojo); color: var(--hoja); }

  /* ── Enviar ── */
  .tf-submit {
    display: none;
    align-items: center;
    justify-content: center;
    margin-top: 2.6rem;
    padding: 1rem 1.5rem;
    border: 0;
    border-radius: 2px;
    background: var(--tinta);
    color: var(--papel);
    font-family: var(--f-grot);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.5s var(--ease-expo);
  }

  .tf-step[data-step='5'].active .tf-submit { display: inline-flex; }
  .tf-submit:hover:not(.loading) { background: var(--rojo); }

  .tf-submit.loading {
    width: 44px;
    height: 44px;
    padding: 0;
    color: transparent;
    border-radius: 50%;
    border: 2px solid var(--linea);
    border-top-color: var(--rojo);
    background: transparent;
    animation: tf-spin 1s linear infinite;
    pointer-events: none;
  }

  @keyframes tf-spin { to { transform: rotate(360deg); } }

  .tf-error {
    margin-top: 1.4rem;
    font-family: var(--f-serif);
    font-style: italic;
    color: var(--rojo);
  }

  /* ── Recibido ── */
  .tf-success-mark {
    font-family: var(--f-grot);
    font-weight: 900;
    font-size: clamp(4rem, 11vw, 11rem);
    line-height: 0.82;
    letter-spacing: -0.06em;
    text-transform: lowercase;
    color: var(--rojo);
  }

  .tf-success {
    margin-top: 1.6rem;
    max-width: 30ch;
    font-family: var(--f-serif);
    font-weight: 400;
    font-size: clamp(1.4rem, 2.4vw, 2.2rem);
    line-height: 1.2;
  }

  /* ── Flechas ── */
  .tf-controls {
    position: absolute;
    right: var(--gutter);
    bottom: 3rem;
    z-index: 100;
    display: flex;
    gap: 0.5rem;
    transition: opacity 0.5s ease;
  }

  .tf-nav-btn {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--tinta);
    border-radius: 2px;
    background: transparent;
    color: var(--tinta);
    cursor: pointer;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .tf-nav-btn:hover:not(:disabled) { background: var(--tinta); color: var(--papel); }
  .tf-nav-btn:disabled { opacity: 0.25; cursor: not-allowed; }

  /* ── Móvil ── */
  @media (max-width: 900px) {
    .tf { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr; }
    .tf__side {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-end;
      gap: 12px 24px;
      padding: 96px var(--gutter) 0;
    }
    .tf__side .lv-kicker { width: 100%; }
    .tf__count b { font-size: 22vw; }
    .tf__art { display: none; }
    .steps-wrapper { min-height: 70svh; }
    .tf-step { padding: 0 var(--gutter); }
    .tf-controls { bottom: 1.5rem; }
  }
</style>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('astro:page-load', () => {
    const container = document.getElementById('typeform-app');
    if (!container || container.dataset.bound) return;
    container.dataset.bound = 'true';

    const dictRaw = container.getAttribute('data-dict') || '{}';
    let dict: Record<string, any> = {};
    try { dict = JSON.parse(dictRaw); } catch (e) {}

    const STORAGE_KEY = 'andrevalle_typeform_state';
    const storage = {
      get: () => { try { return localStorage.getItem(STORAGE_KEY); } catch { return null; } },
      set: (v: string) => { try { localStorage.setItem(STORAGE_KEY, v); } catch {} },
      clear: () => { try { localStorage.removeItem(STORAGE_KEY); } catch {} },
    };

    let currentStep = 1;
    const totalSteps = 5; // Step 6 is success
    const state = {
      name: '',
      intent: '', // 'a', 'b', or 'c'
      subIntent: '',
      details: '',
      email: ''
    };

    const steps = Array.from(container.querySelectorAll('.tf-step'));
    const btnUp = document.getElementById('tf-up') as HTMLButtonElement | null;
    const btnDown = document.getElementById('tf-down') as HTMLButtonElement | null;
    const progressFill = document.getElementById('progress-fill');
    const countEl = document.getElementById('tf-count');
    const nums = Array.from(container.querySelectorAll<HTMLElement>('#tf-nums li'));

    // Inputs & Labels
    const inputName = document.getElementById('tf-name') as HTMLInputElement;
    const q2Label = document.getElementById('q2-label');
    const q3Label = document.getElementById('q3-label');
    const q3Opt1 = document.getElementById('q3-opt1');
    const q3Opt2 = document.getElementById('q3-opt2');
    const q3Opt3 = document.getElementById('q3-opt3');
    const q4Label = document.getElementById('q4-label');

    const optsStep2 = container.querySelectorAll('#options-step-2 .tf-option');
    const optsStep3 = container.querySelectorAll('#options-step-3 .tf-option');
    const inputDetails = document.getElementById('tf-details') as HTMLTextAreaElement;
    const inputEmail = document.getElementById('tf-email') as HTMLInputElement;
    const btnSubmit = document.getElementById('tf-submit');

    // 1. LocalStorage Logic
    const saved = storage.get();
    if (saved) {
      try {
        const parsed = JSON.parse(saved);
        if (parsed.step && parsed.step <= totalSteps) {
          currentStep = parsed.step;
          state.name = parsed.state.name || '';
          state.intent = parsed.state.intent || '';
          state.subIntent = parsed.state.subIntent || '';
          state.details = parsed.state.details || '';
          state.email = parsed.state.email || '';

          if (inputName) inputName.value = state.name;
          if (inputDetails) inputDetails.value = state.details;
          if (inputEmail) inputEmail.value = state.email;

          if (state.intent) {
            const opt = container.querySelector(`#options-step-2 .tf-option[data-value="${state.intent}"]`);
            if (opt) opt.classList.add('selected');
            applyTheme(state.intent);
            populateDynamicTexts();
          }
          if (state.subIntent) {
            const opt = container.querySelector(`#options-step-3 .tf-option[data-value="${state.subIntent}"]`);
            if (opt) opt.classList.add('selected');
          }
        }
      } catch (e) {}
    }

    function saveState() {
      storage.set(JSON.stringify({ step: currentStep, state }));
    }

    function applyTheme(intent: string) {
      container?.classList.remove('theme-a', 'theme-b', 'theme-c');
      if (intent) container?.classList.add(`theme-${intent}`);
    }

    function populateDynamicTexts() {
      if (!state.intent || !dict[state.intent]) return;
      const tData = dict[state.intent];
      if (q3Label) q3Label.textContent = tData.q3;
      if (q3Opt1) q3Opt1.textContent = tData.opt1;
      if (q3Opt2) q3Opt2.textContent = tData.opt2;
      if (q3Opt3) q3Opt3.textContent = tData.opt3;
      if (q4Label) q4Label.textContent = tData.q4;
    }

    // 2. Cinematic Focus Dimming
    function handleFocus() {
      container?.classList.add('tf-is-focused');
      const nav = document.getElementById('navbar');
      if (nav) {
        nav.style.transition = 'opacity 0.5s ease';
        nav.style.opacity = '0.5';
      }
    }

    function handleBlur() {
      container?.classList.remove('tf-is-focused');
      const nav = document.getElementById('navbar');
      if (nav) nav.style.opacity = '1';
    }

    container.querySelectorAll('.tf-input').forEach((input) => {
      input.addEventListener('focus', handleFocus);
      input.addEventListener('blur', handleBlur);
      input.addEventListener('input', () => {
        if (input === inputName) state.name = inputName.value;
        if (input === inputDetails) state.details = inputDetails.value;
        if (input === inputEmail) state.email = inputEmail.value;
        saveState();
      });
    });

    // Init display
    updateDisplay();

    function updateProgress() {
      const shown = Math.min(currentStep, totalSteps);
      if (progressFill) progressFill.style.width = `${((currentStep - 1) / totalSteps) * 100}%`;
      if (countEl) countEl.textContent = String(shown).padStart(2, '0');
      nums.forEach((li) => {
        const n = Number(li.dataset.n);
        li.classList.toggle('is-current', n === currentStep);
        li.classList.toggle('is-done', n < currentStep);
      });
    }

    function updateDisplay(dir = 1) {
      saveState();
      updateProgress();

      if (btnUp) btnUp.disabled = currentStep === 1 || currentStep > totalSteps;
      if (btnDown) btnDown.disabled = currentStep >= totalSteps;

      steps.forEach((step) => {
        const stepNum = parseInt(step.getAttribute('data-step') || '1');
        if (stepNum === currentStep) {
          step.classList.add('active');
          gsap.fromTo(step,
            { y: dir > 0 ? 50 : -50, opacity: 0 },
            { y: 0, opacity: 1, duration: 0.9, ease: 'expo.out', delay: 0.2 }
          );

          setTimeout(() => {
            const input = step.querySelector('input, textarea') as HTMLElement;
            if (input) input.focus();
          }, 800);
        } else if (step.classList.contains('active')) {
          gsap.to(step, {
            y: dir > 0 ? -50 : 50,
            opacity: 0,
            duration: 0.5,
            ease: 'power2.in',
            onComplete: () => step.classList.remove('active')
          });
        }
      });

      if (currentStep === 2 && q2Label) {
        const rawText = q2Label.getAttribute('data-raw') || '';
        const nameToUse = state.name.trim() ? state.name.trim().split(' ')[0] : 'friend';
        q2Label.textContent = rawText.replace('{name}', nameToUse);
      }
    }

    function nextStep() {
      if (currentStep > totalSteps) return;
      if (currentStep === 1 && !state.name.trim()) return;
      if (currentStep === 2 && !state.intent) return;
      if (currentStep === 3 && !state.subIntent) return;

      currentStep++;
      updateDisplay(1);
    }

    function prevStep() {
      if (currentStep <= 1 || currentStep > totalSteps) return;
      currentStep--;
      updateDisplay(-1);
    }

    if (btnUp) btnUp.addEventListener('click', prevStep);
    if (btnDown) btnDown.addEventListener('click', nextStep);

    [inputName, inputDetails, inputEmail].forEach((input) => {
      if (!input) return;
      input.addEventListener('keydown', (evt) => {
        const e = evt as KeyboardEvent;
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          if (input === inputEmail && btnSubmit) btnSubmit.click();
          else nextStep();
        }
      });
    });

    if (inputDetails) {
      inputDetails.addEventListener('input', function () {
        this.style.height = 'auto';
        this.style.height = this.scrollHeight + 'px';
      });
    }

    // Step 2 Options
    optsStep2.forEach((opt) => {
      opt.addEventListener('click', () => {
        optsStep2.forEach((o) => o.classList.remove('selected'));
        opt.classList.add('selected');
        state.intent = opt.getAttribute('data-value') || '';
        applyTheme(state.intent);
        populateDynamicTexts();
        saveState();
        setTimeout(nextStep, 400);
      });
    });

    // Step 3 Options
    optsStep3.forEach((opt) => {
      opt.addEventListener('click', () => {
        optsStep3.forEach((o) => o.classList.remove('selected'));
        opt.classList.add('selected');
        state.subIntent = opt.getAttribute('data-value') || '';
        saveState();
        setTimeout(nextStep, 400);
      });
    });

    // Keyboard shortcuts (A, B, C) mapped to active step
    const onKey = (e: KeyboardEvent) => {
      if (!container.isConnected) {
        document.removeEventListener('keydown', onKey);
        return;
      }
      if (currentStep !== 2 && currentStep !== 3) return;
      const key = e.key.toLowerCase();
      const activeOpts = currentStep === 2 ? optsStep2 : optsStep3;
      const index = ['a', 'b', 'c'].indexOf(key);
      if (index !== -1) (activeOpts[index] as HTMLElement | undefined)?.click();
    };
    document.addEventListener('keydown', onKey);

    // Submit
    const errorEl = document.getElementById('tf-error');

    if (btnSubmit) {
      btnSubmit.addEventListener('click', async () => {
        state.email = inputEmail.value.trim();
        if (!state.email || !state.email.includes('@')) return;

        if (errorEl) errorEl.hidden = true;
        btnSubmit.classList.add('loading');

        const payload = {
          name: state.name,
          email: state.email,
          details: state.details,
          intent: state.intent,
          subIntent: state.subIntent,
          subIntentLabel: dict[state.intent]?.[state.subIntent] || state.subIntent,
        };

        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (!res.ok) throw new Error(String(res.status));

          currentStep = 6; // Success step
          storage.clear();
          updateDisplay(1);
          if (progressFill) progressFill.style.width = '100%';
        } catch (err) {
          console.error('[typeform] submit failed', err);
          btnSubmit.classList.remove('loading');
          if (errorEl) {
            errorEl.textContent = container?.getAttribute('data-error') || 'Something went wrong.';
            errorEl.hidden = false;
          }
        }
      });
    }
  });
</script>
