---
/**
 * ── Bandera ───────────────────────────────────────────
 *
 * Banderín pintado a mano en un palito, ondeando. Impresas con
 * las tintas de la casa, como una risografía: el amarillo sale
 * naranja, el verde es olivo, el blanco es papel.
 * Países: los 12 que Cord sostiene de punta a punta.
 */
import type { CountryCode } from '../../data/cases/cord';

interface Props {
  code: CountryCode;
  draw?: 'load' | 'scroll' | 'manual' | 'none';
  delay?: number;
  label?: string;
  class?: string;
}

const { code, draw = 'scroll', delay = 0, label, class: className } = Astro.props;
const clipId = `bandera-${code}-${Math.random().toString(36).slice(2, 7)}`;

const R = 'var(--rojo)';
const B = 'var(--azul)';
const N = 'var(--pint-naranja)';
const G = 'var(--verde)';
const C = 'var(--cielo)';
const W = '#F4F2ED';
const K = 'var(--tinta)';

/* Tela ondeando (x 14–154, y 8–106) */
const cloth = 'M14 14 C50 4 92 22 154 10 L154 96 C118 108 76 88 14 102 Z';

type Rect = [number, number, number, number, string];
const h3 = (a: string, b: string, c: string): Rect[] => [[0, 0, 170, 40, a], [0, 40, 170, 32, b], [0, 72, 170, 50, c]];
const v3 = (a: string, b: string, c: string): Rect[] => [[0, 0, 61, 120, a], [61, 0, 47, 120, b], [108, 0, 62, 120, c]];

const RECTS: Record<CountryCode, Rect[]> = {
  MX: v3(G, W, R),
  US: [
    ...Array.from({ length: 7 }, (_, i): Rect => [0, i * 17, 170, 8.5, R]),
    ...Array.from({ length: 7 }, (_, i): Rect => [0, i * 17 + 8.5, 170, 8.5, W]),
    [0, 0, 70, 52, B],
  ],
  CA: [[0, 0, 50, 120, R], [50, 0, 70, 120, W], [120, 0, 50, 120, R]],
  BR: [[0, 0, 170, 120, G]],
  ES: [[0, 0, 170, 36, R], [0, 36, 170, 36, N], [0, 72, 170, 50, R]],
  GB: [[0, 0, 170, 120, B]],
  DE: h3(K, R, N),
  FR: v3(B, W, R),
  CO: [[0, 0, 170, 58, N], [0, 58, 170, 28, B], [0, 86, 170, 36, R]],
  AR: h3(C, W, C),
  CL: [[0, 0, 170, 56, W], [0, 0, 62, 56, B], [0, 56, 170, 66, R]],
  PE: v3(R, W, R),
};

const star = (cx: number, cy: number, rr: number) => {
  const pts = Array.from({ length: 10 }, (_, i) => {
    const a = -Math.PI / 2 + (i * Math.PI) / 5;
    const rad = i % 2 === 0 ? rr : rr * 0.42;
    return `${(cx + Math.cos(a) * rad).toFixed(1)} ${(cy + Math.sin(a) * rad).toFixed(1)}`;
  });
  return `M${pts.join(' L')} Z`;
};
const usStars = Array.from({ length: 12 }, (_, i) => [10 + (i % 4) * 16, 10 + Math.floor(i / 4) * 15]);
const sunRays = Array.from({ length: 12 }, (_, i) => {
  const a = (i / 12) * Math.PI * 2;
  return `M${(84 + Math.cos(a) * 10).toFixed(1)} ${(55 + Math.sin(a) * 10).toFixed(1)} L${(84 + Math.cos(a) * 16).toFixed(1)} ${(55 + Math.sin(a) * 16).toFixed(1)}`;
}).join(' ');
const maple = 'M84 24 L89 38 L96 33 L94 50 L106 44 L102 56 L110 60 L96 68 L98 76 L86 72 L86 88 L82 88 L82 72 L70 76 L72 68 L58 60 L66 56 L62 44 L74 50 L72 33 L79 38 Z';
---

<svg
  class:list={['lv-art', className]}
  viewBox="0 0 170 170"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  data-draw={draw === 'none' ? undefined : draw}
  data-delay={delay}
>
  <defs>
    <clipPath id={clipId}><path d={cloth} /></clipPath>
  </defs>

  <g clip-path={`url(#${clipId})`}>
    <g filter="url(#ink)">
      {RECTS[code].map(([x, y, w, h, fill]) => <rect data-fill x={x} y={y} width={w} height={h} style={`fill: ${fill}`} />)}

      {code === 'MX' && (
        <g>
          <circle data-pop cx="84" cy="54" r="12" fill="none" stroke="var(--cognac)" stroke-width="3" />
          <path data-pop d="M76 50 C80 44 88 44 92 50 C88 56 80 58 76 50 Z" style="fill: var(--cognac)" />
          <path data-pop d="M72 66 C78 72 90 72 96 66" fill="none" stroke="var(--verde)" stroke-width="2.4" />
        </g>
      )}
      {code === 'US' && usStars.map(([x, y]) => <circle data-pop cx={x} cy={y} r="2.4" fill={W} />)}
      {code === 'CA' && <path data-pop d={maple} style={`fill: ${R}`} />}
      {code === 'BR' && (
        <g>
          <path data-fill d="M84 18 L144 56 L84 94 L24 56 Z" style={`fill: ${N}`} />
          <circle data-fill cx="84" cy="56" r="22" style={`fill: ${B}`} />
          <path data-pop d="M63 52 C76 46 94 48 105 58" fill="none" stroke={W} stroke-width="3" />
        </g>
      )}
      {code === 'ES' && <rect data-pop x="40" y="44" width="16" height="22" style={`fill: ${R}`} stroke={K} stroke-width="1.5" />}
      {code === 'GB' && (
        <g fill="none" stroke-linecap="butt">
          <path data-pop d="M0 0 L170 120 M170 0 L0 120" stroke={W} stroke-width="20" />
          <path data-pop d="M0 0 L170 120 M170 0 L0 120" style={`stroke: ${R}`} stroke-width="6" />
          <path data-pop d="M84 0 L84 120 M0 56 L170 56" stroke={W} stroke-width="28" />
          <path data-pop d="M84 0 L84 120 M0 56 L170 56" style={`stroke: ${R}`} stroke-width="15" />
        </g>
      )}
      {code === 'AR' && (
        <g>
          <circle data-pop cx="84" cy="55" r="7" style={`fill: ${N}`} />
          <path data-pop d={sunRays} fill="none" style={`stroke: ${N}`} stroke-width="2.4" stroke-linecap="round" />
        </g>
      )}
      {code === 'CL' && <path data-pop d={star(31, 28, 12)} fill={W} />}
      {code === 'PE' && <circle data-pop cx="84" cy="55" r="8" fill="none" stroke="var(--verde)" stroke-width="2.4" />}
    </g>
  </g>

  <g filter="url(#ink-fino)" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <path data-s stroke-width="2.4" d={cloth} />
    <path data-s stroke-width="4" d="M12 6 L12 166" />
  </g>
  <circle data-pop cx="12" cy="5" r="4" fill="currentColor" />
</svg>
