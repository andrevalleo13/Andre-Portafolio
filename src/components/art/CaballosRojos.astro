---
/**
 * ── Dos caballos rojos ────────────────────────────────
 *
 * Dos caballitos al galope en tinta roja, chicos y juntos, como
 * un tatuaje fino en el hombro.
 */
interface Props {
  draw?: 'load' | 'scroll' | 'manual' | 'none';
  delay?: number;
  label?: string;
  class?: string;
}

const {
  draw = 'scroll',
  delay = 0,
  label = 'Dos caballos rojos al galope, como un tatuaje',
  class: className,
} = Astro.props;

const horses = [
  { x: 10, y: 20 },
  { x: 128, y: 12 },
];
---

<svg
  class:list={['lv-art', 'lv-art-red', className]}
  viewBox="0 0 250 90"
  role="img"
  aria-label={label}
  data-draw={draw === 'none' ? undefined : draw}
  data-delay={delay}
>
  <g filter="url(#ink-fino)" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    {horses.map(({ x, y }) => (
      <g transform={`translate(${x} ${y})`}>
        <path data-s stroke-width="15" d="M34 32 C46 26 66 26 80 30" />
        <path data-s stroke-width="8" d="M78 29 C86 22 92 16 98 12" />
        <path data-s stroke-width="6" d="M96 12 C102 10 108 13 113 19" />
        <path data-s stroke-width="3" d="M80 35 C88 40 98 42 112 38" />
        <path data-s stroke-width="3" d="M76 37 C80 46 86 52 96 56" />
        <path data-s stroke-width="3" d="M38 37 C28 42 18 44 6 40" />
        <path data-s stroke-width="3" d="M42 39 C40 48 34 55 24 60" />
        <path data-s stroke-width="2.6" d="M28 28 C20 22 12 22 2 26" />
      </g>
    ))}
  </g>
</svg>
