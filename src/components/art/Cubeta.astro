---
/**
 * ── Cubeta que gotea ──────────────────────────────────
 *
 * Una cubeta de lámina con agua azul y un agujero abajo por donde
 * se escapan las gotas: el churn. Portada del memo de métricas.
 */
interface Props {
  draw?: 'load' | 'scroll' | 'manual' | 'none';
  delay?: number;
  label?: string;
  class?: string;
}

const {
  draw = 'scroll',
  delay = 0,
  label = 'Cubeta con agua que gotea por un agujero',
  class: className,
} = Astro.props;

const bucket = 'M44 70 L176 70 L160 196 C158 206 62 206 60 196 Z';
const drops = [[150, 206, 5], [156, 222, 4], [146, 236, 3.4]];
---

<svg
  class:list={['lv-art', className]}
  viewBox="0 0 220 260"
  role="img"
  aria-label={label}
  data-draw={draw === 'none' ? undefined : draw}
  data-delay={delay}
>
  <g filter="url(#ink-fino)">
    <path data-fill d={bucket} fill="#D8D5CF" />
    <path data-fill d="M48 90 C80 82 140 98 172 88 L160 196 C158 206 62 206 60 196 Z" style="fill: var(--azul)" fill-opacity="0.75" />
    <ellipse data-fill cx="110" cy="246" rx="44" ry="7" style="fill: var(--azul)" fill-opacity="0.35" />
  </g>
  <g filter="url(#ink-fino)" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <path data-s stroke-width="2.6" d={bucket} />
    <path data-s stroke-width="2.4" d="M44 70 C44 62 176 62 176 70 C176 78 44 78 44 70 Z" />
    <path data-s stroke-width="2.4" d="M50 74 C40 10 180 10 170 74" />
    <path data-s stroke-width="1.2" d="M52 120 L168 120 M56 160 L164 160" stroke-opacity="0.5" />
  </g>
  <circle data-pop cx="148" cy="190" r="4" fill="currentColor" />
  <g filter="url(#ink-fino)" style="fill: var(--azul)">
    {drops.map(([cx, cy, r]) => <path data-pop d={`M${cx} ${cy - r * 1.8} C${cx + r} ${cy - r * 0.4} ${cx + r} ${cy + r} ${cx} ${cy + r} C${cx - r} ${cy + r} ${cx - r} ${cy - r * 0.4} ${cx} ${cy - r * 1.8} Z`} />)}
  </g>
</svg>
