---
/**
 * ── Bocetos ───────────────────────────────────────────
 *
 * Dibujos chicos a pluma para contar lo que hace cada producto
 * (casos de Cord y Flouvia). Mismo trazo que el resto del sitio.
 *
 *   Cord:     cotizacion · firma · tarjeta · recibo · candado · sobre ·
 *             calendario · cadenaHash · flujo · engranes
 *   Flouvia:  huacal · lupa · gota · letra · cubo · portal · pin
 */
type Kind =
  | 'cotizacion' | 'firma' | 'tarjeta' | 'recibo' | 'candado' | 'sobre' | 'calendario' | 'cadenaHash' | 'flujo' | 'engranes'
  | 'huacal' | 'lupa' | 'gota' | 'letra' | 'cubo' | 'portal' | 'pin';

interface Props {
  kind: Kind;
  draw?: 'load' | 'scroll' | 'manual' | 'none';
  delay?: number;
  label?: string;
  class?: string;
}

const { kind, draw = 'scroll', delay = 0, label, class: className } = Astro.props;

const VIEW: Record<Kind, string> = {
  cotizacion: '0 0 200 240', firma: '0 0 240 120', tarjeta: '0 0 230 150', recibo: '0 0 180 260',
  candado: '0 0 170 210', sobre: '0 0 240 160', calendario: '0 0 250 230', cadenaHash: '0 0 390 120',
  flujo: '0 0 440 170', engranes: '0 0 330 220', huacal: '0 0 280 230', lupa: '0 0 230 230',
  gota: '0 0 220 270', letra: '0 0 260 270', cubo: '0 0 250 240', portal: '0 0 520 340', pin: '0 0 90 130',
};

/* ── Datos generados ── */
const rows = [86, 110, 134, 158];
const calCells = Array.from({ length: 28 }, (_, i) => ({ x: 24 + (i % 7) * 30, y: 74 + Math.floor(i / 7) * 34, i }));
const gear = (cx: number, cy: number, R: number, r: number, n: number) => {
  const pts: string[] = [];
  for (let i = 0; i < n; i++) {
    const a = (i / n) * Math.PI * 2;
    const step = (Math.PI * 2) / n;
    [[a, r], [a + step * 0.15, R], [a + step * 0.5, R], [a + step * 0.65, r]].forEach(([ang, rad]) =>
      pts.push(`${(cx + Math.cos(ang) * rad).toFixed(1)} ${(cy + Math.sin(ang) * rad).toFixed(1)}`)
    );
  }
  return `M${pts.join(' L')} Z`;
};
const produce = [
  { k: 'tomate', x: 64, y: 108 }, { k: 'aguacate', x: 96, y: 100 }, { k: 'tomate', x: 128, y: 104 },
  { k: 'chile', x: 156, y: 98 }, { k: 'tomate', x: 186, y: 106 }, { k: 'aguacate', x: 216, y: 100 },
  { k: 'tomate', x: 80, y: 84 }, { k: 'tomate', x: 146, y: 80 }, { k: 'chile', x: 200, y: 80 },
];
const gotaIcons = [
  'M70 140 L74 132 L78 140 L86 141 L80 146 L82 154 L74 150 L66 154 L68 146 L62 141 Z',
  'M104 146 L110 152 L120 138',
  'M142 146 L162 146 M154 138 L162 146 L154 154',
  'M64 182 C64 172 82 172 82 182 C82 192 64 192 64 182 Z',
  'M110 172 L110 192 M100 182 L120 182',
  'M150 172 L144 184 L154 184 L148 196',
  'M64 222 C70 214 82 214 86 222 C82 230 70 230 64 222 Z',
  'M110 212 C100 214 98 230 110 232 C104 226 104 218 110 212 Z',
  'M144 214 L164 214 L160 232 L148 232 Z',
];
const hashes = ['a3f9·e1c0', '7c2b·0f48', 'd81e·9a37'];
---

