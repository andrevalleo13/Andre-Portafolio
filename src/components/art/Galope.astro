---
/**
 * ── Tres al galope ────────────────────────────────────
 *
 * Tres caballos a pincel corriendo en fila, con una estrella
 * roja a pluma y destellos ocre detrás.
 */
interface Props {
  draw?: 'load' | 'scroll' | 'manual' | 'none';
  delay?: number;
  label?: string;
  class?: string;
}

const {
  draw = 'scroll',
  delay = 0,
  label = 'Tres caballos negros al galope con una estrella roja',
  class: className,
} = Astro.props;

const horses = [
  { x: 40, y: 26 },
  { x: 160, y: 20 },
  { x: 280, y: 28 },
];
---

<svg
  class:list={['lv-art', className]}
  viewBox="0 0 410 110"
  role="img"
  aria-label={label}
  data-draw={draw === 'none' ? undefined : draw}
  data-delay={delay}
>
  <g filter="url(#ink-fino)" fill="none" stroke="var(--pint-1)" stroke-width="1.6" stroke-linecap="round">
    <path data-s d="M30 30 L14 18 M34 22 L30 4 M40 30 L56 14 M24 40 L6 44 M150 24 L140 8 M262 30 L250 16 M400 40 L408 28" />
  </g>
  <g filter="url(#ink)" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    {horses.map(({ x, y }) => (
      <g transform={`translate(${x} ${y})`}>
        <path data-s stroke-width="17" d="M34 32 C46 26 66 26 80 30" />
        <path data-s stroke-width="9" d="M78 29 C86 22 92 16 98 12" />
        <path data-s stroke-width="7" d="M96 12 C102 10 108 13 113 19" />
        <path data-s stroke-width="2.5" d="M98 10 L100 4" />
        <path data-s stroke-width="2" d="M96 11 L90 9 L93 15 L86 14 L89 20 L82 19" />
        <path data-s stroke-width="3.5" d="M80 35 C88 40 98 42 112 38" />
        <path data-s stroke-width="3.5" d="M76 37 C80 46 86 52 96 56" />
        <path data-s stroke-width="3.5" d="M38 37 C28 42 18 44 6 40" />
        <path data-s stroke-width="3.5" d="M42 39 C40 48 34 55 24 60" />
        <path data-s stroke-width="3" d="M28 28 C20 22 12 22 2 26" />
      </g>
    ))}
  </g>
  <path
    data-s
    class="lv-art-red"
    filter="url(#ink-fino)"
    fill="none"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linejoin="round"
    d="M24 12 L30 -4 L35 12 L52 12 L39 22 L44 38 L30 28 L16 38 L21 22 L8 12 Z"
  />
</svg>
