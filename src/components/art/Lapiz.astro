---
/**
 * ── Lápiz ─────────────────────────────────────────────
 *
 * Un lápiz azul trazando una línea que empieza como garabato y
 * termina recta: la fricción que se quita. Portada del memo de UX.
 */
interface Props {
  draw?: 'load' | 'scroll' | 'manual' | 'none';
  delay?: number;
  label?: string;
  class?: string;
}

const {
  draw = 'scroll',
  delay = 0,
  label = 'Lápiz trazando una línea que empieza como garabato y termina recta',
  class: className,
} = Astro.props;
---

<svg
  class:list={['lv-art', className]}
  viewBox="0 0 260 200"
  role="img"
  aria-label={label}
  data-draw={draw === 'none' ? undefined : draw}
  data-delay={delay}
>
  <!-- la línea: garabato que se endereza -->
  <path data-s class="lv-art-red" filter="url(#ink-fino)" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"
    d="M14 160 L22 138 L30 166 L40 132 L48 162 L58 140 L66 156 C80 148 96 146 112 140 C130 134 150 128 166 122" />
  <g transform="rotate(-24 196 96)">
    <g filter="url(#ink-fino)">
      <path data-fill d="M176 84 L176 108 L154 96 Z" fill="#E9D7B8" />
      <path data-fill d="M176 84 L236 84 L236 108 L176 108 Z" style="fill: var(--azul)" />
      <path data-fill d="M236 82 L248 82 L248 110 L236 110 Z" fill="#B9B4AB" />
      <path data-fill d="M248 82 L262 84 L262 108 L248 110 Z" class="lv-art-red-fill" />
    </g>
    <g filter="url(#ink-fino)" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
      <path data-s d="M176 84 L176 108 L154 96 Z M176 84 L236 84 L236 108 L176 108 M236 82 L248 82 L248 110 L236 110 Z M248 82 L262 84 L262 108 L248 110" />
      <path data-s d="M176 92 L236 92 M176 100 L236 100" stroke="#F4F2ED" stroke-width="1.2" />
    </g>
    <path data-pop d="M160 93 L154 96 L160 99 Z" fill="currentColor" />
  </g>
</svg>
