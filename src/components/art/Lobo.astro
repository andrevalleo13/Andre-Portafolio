---
/**
 * ── Lobo ──────────────────────────────────────────────
 *
 * Lobo negro pintado a pincel, gruñendo: cuerpo bajo y pesado,
 * orejas grandes, hocico abierto con dientes, ojo naranja, cola
 * espesa levantada, una cadena azul rota y un garabato rojo
 * saliendo del hocico. El animal de André.
 */
interface Props {
  draw?: 'load' | 'scroll' | 'manual' | 'none';
  delay?: number;
  label?: string;
  class?: string;
}

const {
  draw = 'scroll',
  delay = 0,
  label = 'Lobo negro gruñendo, con una cadena rota y un garabato rojo',
  class: className,
} = Astro.props;

/* Eslabones de la cadena, del cuello hacia arriba a la derecha */
const links = Array.from({ length: 5 }, (_, i) => ({
  cx: 252 + i * 19,
  cy: 112 - i * 17,
  rot: i % 2 === 0 ? -48 : 42,
}));
---

<svg
  class:list={['lv-art', className]}
  viewBox="0 0 360 270"
  role="img"
  aria-label={label}
  data-draw={draw === 'none' ? undefined : draw}
  data-delay={delay}
>
  <g filter="url(#ink)" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <!-- cola espesa, levantada -->
    <path data-s stroke-width="24" d="M100 150 C78 140 64 120 60 94" />
    <path data-s stroke-width="7" d="M98 158 C80 152 64 138 54 116" />
    <!-- cuerpo bajo y pesado -->
    <path data-s stroke-width="46" d="M98 154 C140 142 196 144 236 154" />
    <path data-s stroke-width="26" d="M110 174 C152 180 198 178 230 168" />
    <!-- cuello y cabeza baja, gruñendo -->
    <path data-s stroke-width="32" d="M232 150 C246 142 258 136 268 132" />
    <path data-s stroke-width="25" d="M264 130 C278 122 296 122 308 130" />
    <!-- hocico abierto -->
    <path data-s stroke-width="12" d="M300 126 L338 132" />
    <path data-s stroke-width="8" d="M298 140 L332 154" />
    <!-- orejas grandes -->
    <path data-s stroke-width="9" d="M266 122 L270 88 L286 116" />
    <path data-s stroke-width="8" d="M284 118 L296 90 L302 120" />
    <!-- lomo y pecho erizados -->
    <path data-s stroke-width="3" d="M120 132 L126 116 L136 132 L144 114 L154 130 L162 114 L172 130 L180 116 L190 130 L198 116 L208 132 L216 120 L224 134" />
    <path data-s stroke-width="3" d="M238 166 L246 178 L252 164 L260 174 L264 160" />
    <!-- patas cortas y firmes -->
    <path data-s stroke-width="9" d="M120 176 C116 202 114 224 112 244" />
    <path data-s stroke-width="9" d="M140 178 C144 204 148 226 150 244" />
    <path data-s stroke-width="9" d="M214 174 C216 200 212 224 208 244" />
    <path data-s stroke-width="9" d="M234 166 C242 194 246 222 250 244" />
    <path data-s stroke-width="6" d="M102 246 L120 246 M144 246 L160 246 M198 246 L214 246 M244 246 L262 246" />
    <path data-s stroke-width="2.5" d="M104 250 L100 258 M112 250 L110 258 M252 250 L256 258 M260 250 L266 258" />
  </g>

  <!-- dientes -->
  <g filter="url(#ink-fino)" fill="#F4F2ED" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
    <path data-pop d="M306 130 L310 138 L313 131 Z M315 131 L319 140 L322 132 Z M324 132 L328 140 L331 133 Z" />
    <path data-pop d="M306 143 L310 136 L313 146 Z M315 147 L319 139 L322 150 Z" />
  </g>
  <circle data-pop cx="290" cy="126" r="3.4" style="fill: var(--pint-naranja)" />

  <!-- cadena rota -->
  <g filter="url(#ink-fino)" class="lv-art-blue" fill="none" stroke="currentColor" stroke-width="4">
    {links.map(({ cx, cy, rot }) => (
      <ellipse data-s cx={cx} cy={cy} rx="11" ry="6" transform={`rotate(${rot} ${cx} ${cy})`} />
    ))}
  </g>

  <!-- garabato rojo saliendo del hocico -->
  <path
    data-s
    class="lv-art-red"
    filter="url(#ink-fino)"
    fill="none"
    stroke="currentColor"
    stroke-width="2.6"
    stroke-linecap="round"
    d="M336 136 C352 120 358 142 344 150 C328 160 322 134 342 126 C360 118 360 152 344 160 C328 168 316 150 326 136 C336 122 358 128 356 144"
  />
</svg>
