---
/**
 * ── La manga rota ─────────────────────────────────────
 *
 * Un reloj de acero (carátula blanca, números romanos, fecha a las
 * 3, brazalete de eslabones) asomando por un agujero roto en la
 * manga de un suéter gris oscuro, con hilos deshilachados alrededor.
 * La imagen que resume el estilo de André: una pieza seria metida en
 * algo gastado. Sin marca escrita.
 */
interface Props {
  draw?: 'load' | 'scroll' | 'manual' | 'none';
  delay?: number;
  label?: string;
  class?: string;
}

const {
  draw = 'scroll',
  delay = 0,
  label = 'Reloj de acero asomando por un agujero roto en la manga de un suéter',
  class: className,
} = Astro.props;

const uid = Math.random().toString(36).slice(2, 8);
const holeClip = `manga-hueco-${uid}`;
const sleeveClip = `manga-tela-${uid}`;

/* Variación fija (misma forma en cada carga) */
const jitter = (i: number, amp: number) => (Math.sin(i * 12.9898) * 43758.5453 % 1) * amp;

/* Manga: la tela llena el cuadro */
const sleeve = 'M6 26 C80 6 222 8 294 30 L296 254 C220 276 82 274 4 252 Z';

/* Agujero roto: elipse con orilla dentada */
const C = { x: 150, y: 142 };
const holePts = Array.from({ length: 46 }, (_, i) => {
  const a = (i / 46) * Math.PI * 2;
  const rx = 76 + jitter(i, 9) + (i % 2 ? -5 : 4);
  const ry = 96 + jitter(i + 7, 10) + (i % 3 ? -4 : 5);
  return [C.x + Math.cos(a) * rx, C.y + Math.sin(a) * ry];
});
const hole = `M${holePts.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join(' L')} Z`;

/* Hilos sueltos: rizos que salen de la orilla hacia adentro */
const threads = holePts
  .filter((_, i) => i % 2 === 0)
  .map(([x, y], i) => {
    const dx = C.x - x;
    const dy = C.y - y;
    const len = Math.hypot(dx, dy);
    const ux = dx / len;
    const uy = dy / len;
    const l = 8 + Math.abs(jitter(i + 3, 14));
    const bend = (i % 2 ? 1 : -1) * (5 + Math.abs(jitter(i, 5)));
    return `M${x.toFixed(1)} ${y.toFixed(1)} Q${(x + ux * l * 0.6 - uy * bend).toFixed(1)} ${(y + uy * l * 0.6 + ux * bend).toFixed(1)} ${(x + ux * l).toFixed(1)} ${(y + uy * l).toFixed(1)}`;
  })
  .join(' ');

/* Tejido: hileras de punto (curvas suaves), recortadas a la tela */
const knit = Array.from({ length: 24 }, (_, i) => {
  const y = 22 + i * 10;
  return `M0 ${y} C75 ${y - 4} 150 ${y + 4} 225 ${y - 2} S300 ${y + 3} 300 ${y}`;
}).join(' ');

/* Reloj */
const R = { case: 64, bezel: 57, dial: 48 };
const polar = (r: number, a: number) => `${(C.x + Math.cos(a) * r).toFixed(1)} ${(C.y + Math.sin(a) * r).toFixed(1)}`;
const bezelTicks = Array.from({ length: 60 }, (_, i) => {
  const a = (i / 60) * Math.PI * 2;
  return `M${polar(R.bezel - 1, a)} L${polar(R.case - 2, a)}`;
}).join(' ');
const minuteTrack = Array.from({ length: 60 }, (_, i) => {
  const a = (i / 60) * Math.PI * 2;
  return `M${polar(R.dial - 2, a)} L${polar(R.dial - (i % 5 === 0 ? 6 : 4), a)}`;
}).join(' ');
const ROMAN = ['XII', 'I', 'II', '', 'IIII', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI'];
const numerals = ROMAN.map((n, i) => {
  const a = (i / 12) * Math.PI * 2 - Math.PI / 2;
  return { n, x: C.x + Math.cos(a) * 36, y: C.y + Math.sin(a) * 36 + 3 };
}).filter((r) => r.n);
const link = (y: number, h: number) =>
  `M${C.x - 32} ${y} L${C.x + 32} ${y} L${C.x + 32} ${y + h} L${C.x - 32} ${y + h} Z M${C.x - 11} ${y} L${C.x - 11} ${y + h} M${C.x + 11} ${y} L${C.x + 11} ${y + h}`;
const topLinks = [28, 46, 64].map((y) => link(y, 16)).join(' ');
const bottomLinks = [204, 222, 240].map((y) => link(y, 16)).join(' ');
---

<svg
  class:list={['lv-art', className]}
  viewBox="0 0 300 280"
  role="img"
  aria-label={label}
  data-draw={draw === 'none' ? undefined : draw}
  data-delay={delay}
>
  <defs>
    <clipPath id={holeClip}><path d={hole} /></clipPath>
    <clipPath id={sleeveClip}><path d={`${sleeve} ${hole}`} clip-rule="evenodd" /></clipPath>
  </defs>

  <!-- dentro del agujero: sombra, brazalete y caja -->
  <g clip-path={`url(#${holeClip})`}>
    <path data-fill d={hole} fill="#2E2B27" />
    <g filter="url(#ink-fino)">
      <path data-fill d={`${topLinks} ${bottomLinks}`} fill="#D8D5CF" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      <circle data-fill cx={C.x} cy={C.y} r={R.case} fill="#CFCBC3" />
      <circle data-fill cx={C.x} cy={C.y} r={R.dial} fill="#FBFAF7" />
    </g>
    <g filter="url(#ink-fino)" fill="none" stroke="currentColor" stroke-linecap="round">
      <circle data-s cx={C.x} cy={C.y} r={R.case} stroke-width="2.4" />
      <circle data-s cx={C.x} cy={C.y} r={R.bezel} stroke-width="1.4" />
      <path data-s d={bezelTicks} stroke-width="1" stroke-opacity="0.7" />
      <circle data-s cx={C.x} cy={C.y} r={R.dial} stroke-width="1.6" />
      <path data-s d={minuteTrack} stroke-width="0.9" />
      <path data-s d={`M${C.x + 32} ${C.y - 7} L${C.x + 44} ${C.y - 7} L${C.x + 44} ${C.y + 7} L${C.x + 32} ${C.y + 7} Z`} stroke-width="1.4" />
      <path data-s d={`M${C.x} ${C.y} L${C.x - 15} ${C.y - 23}`} stroke-width="3.4" />
      <path data-s d={`M${C.x} ${C.y} L${C.x + 5} ${C.y + 38}`} stroke-width="2.6" />
      <path data-s d={`M${C.x} ${C.y} L${C.x - 25} ${C.y + 33}`} stroke-width="1" />
      <path data-s d={`M${C.x + R.case} ${C.y - 7} L${C.x + R.case + 8} ${C.y - 7} L${C.x + R.case + 8} ${C.y + 7} L${C.x + R.case} ${C.y + 7}`} stroke-width="1.8" />
    </g>
    <g fill="currentColor" font-size="9" font-weight="700" text-anchor="middle" style="font-family: var(--f-serif)">
      {numerals.map((r) => <text data-pop x={r.x.toFixed(1)} y={r.y.toFixed(1)}>{r.n}</text>)}
      <text data-pop x={C.x + 38} y={C.y + 3} font-size="8" style="font-family: var(--f-grot)">3</text>
    </g>
    <circle data-pop cx={C.x} cy={C.y} r="2.6" fill="currentColor" />
  </g>

  <!-- la manga, con el agujero -->
  <g filter="url(#ink)">
    <path data-fill d={`${sleeve} ${hole}`} fill-rule="evenodd" fill="#4F4B46" />
  </g>
  <g clip-path={`url(#${sleeveClip})`}>
    <path data-fill d={knit} fill="none" stroke="#6E6860" stroke-width="2" stroke-dasharray="3 3" />
  </g>
  <g filter="url(#ink-fino)" fill="none" stroke-linecap="round">
    <path data-s d={threads} stroke="#8A837A" stroke-width="2" />
    <path data-s d={hole} stroke="#2E2B27" stroke-width="3" stroke-linejoin="round" />
  </g>
</svg>
