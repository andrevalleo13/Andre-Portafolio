---
/**
 * ── Página de libro pintada ───────────────────────────
 *
 * Una hoja arrancada de un libro (bordes rotos, renglones de
 * texto impreso) con frases pintadas encima a brocha roja, en
 * mayúsculas condensadas. Las letras pasan por el filtro de
 * pintura para que el borde se vea de brocha seca.
 */
interface Props {
  lines: string[];
  class?: string;
}

const { lines, class: className } = Astro.props;

/* Renglones de "texto impreso" del libro, dos columnas */
const rows = Array.from({ length: 34 }, (_, i) => i);
---

<div class:list={['pagina', className]}>
  <div class="pagina__print" aria-hidden="true">
    {[0, 1].map(() => (
      <div class="pagina__col">
        {rows.map((i) => <i style={`width:${72 + ((i * 37) % 28)}%`}></i>)}
      </div>
    ))}
  </div>
  <p class="pagina__paint" data-reveal="write" data-delay="0.3">
    {lines.map((l) => <span>{l}</span>)}
  </p>
</div>

<style>
  .pagina {
    position: relative;
    aspect-ratio: 3 / 4;
    max-width: 100%;
    padding: 9% 8%;
    background: #ebe4d6;
    box-shadow: var(--sombra-hoja);
    /* bordes arrancados */
    clip-path: polygon(
      0% 2%, 6% 0%, 14% 1.5%, 22% 0.4%, 31% 1.8%, 40% 0%, 52% 1.2%, 61% 0.2%, 70% 1.6%, 81% 0.3%, 90% 1.4%, 100% 0%,
      99% 12%, 100% 24%, 98.6% 37%, 100% 51%, 99% 64%, 100% 78%, 98.8% 90%, 100% 100%,
      91% 98.6%, 80% 100%, 69% 98.4%, 58% 99.8%, 46% 98.2%, 35% 100%, 24% 98.6%, 13% 99.6%, 4% 98.4%, 0% 100%,
      1.2% 88%, 0% 75%, 1.4% 62%, 0% 48%, 1% 34%, 0% 21%, 1.2% 10%
    );
  }

  .pagina__print {
    position: absolute;
    inset: 9% 8%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8%;
    opacity: 0.38;
  }

  .pagina__col {
    display: grid;
    align-content: start;
    gap: 5px;
  }

  .pagina__col i {
    display: block;
    height: 2px;
    background: #6b6152;
  }

  .pagina__paint {
    position: relative;
    display: grid;
    height: 100%;
    align-content: center;
    gap: 0.06em;
    font-family: var(--f-grot);
    font-weight: 900;
    font-stretch: 75%;
    font-size: clamp(1.8rem, 3.6vw, 3.8rem);
    line-height: 0.92;
    text-transform: uppercase;
    color: var(--rojo);
    filter: url(#brocha);
    rotate: -2deg;
  }

  .pagina__paint span:nth-child(even) { padding-left: 0.4em; }
</style>
