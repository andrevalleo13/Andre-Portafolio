---
/**
 * ── Puro ──────────────────────────────────────────────
 *
 * Un puro color tabaco con anillo rojo, ceniza en la punta y un
 * hilo de humo que se enrosca.
 */
interface Props {
  draw?: 'load' | 'scroll' | 'manual' | 'none';
  delay?: number;
  label?: string;
  class?: string;
}

const {
  draw = 'scroll',
  delay = 0,
  label = 'Puro con anillo rojo y humo',
  class: className,
} = Astro.props;
---

<svg
  class:list={['lv-art', className]}
  viewBox="0 0 320 160"
  role="img"
  aria-label={label}
  data-draw={draw === 'none' ? undefined : draw}
  data-delay={delay}
>
  <g filter="url(#ink-fino)">
    <path data-fill d="M40 112 C30 112 24 104 26 96 C28 88 36 84 46 84 L262 82 C272 82 276 88 276 96 C276 104 272 110 262 110 Z" style="fill: var(--cognac)" />
    <path data-fill d="M262 82 C272 82 276 88 276 96 C276 104 272 110 262 110 L248 110 L248 82 Z" fill="#B9B2A6" />
    <path data-fill d="M84 84 L112 84 L112 112 L84 112 Z" class="lv-art-red-fill" />
  </g>
  <g filter="url(#ink-fino)" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
    <path data-s d="M40 112 C30 112 24 104 26 96 C28 88 36 84 46 84 L262 82 C272 82 276 88 276 96 C276 104 272 110 262 110 Z" />
    <path data-s d="M84 84 L84 112 M112 84 L112 112 M248 82 L248 110" />
    <path data-s d="M130 92 C160 90 190 94 230 90 M140 102 C170 104 200 100 236 102" stroke-width="1" opacity="0.6" />
    <path data-s d="M282 90 C300 80 286 64 298 52 C310 40 296 26 306 14" stroke-width="1.4" />
    <path data-s d="M290 96 C304 92 300 76 310 70" stroke-width="1" />
  </g>
  <text x="98" y="102" text-anchor="middle" font-size="9" font-weight="800" fill="#F4F2ED" style="font-family: var(--f-grot)">AVO</text>
</svg>
