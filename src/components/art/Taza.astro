---
/**
 * ── Taza con estrella ─────────────────────────────────
 *
 * Taza de cerámica hecha a mano: esmalte verde que escurre del
 * borde y una estrella roja pintada al frente.
 */
interface Props {
  draw?: 'load' | 'scroll' | 'manual' | 'none';
  delay?: number;
  label?: string;
  class?: string;
}

const {
  draw = 'scroll',
  delay = 0,
  label = 'Taza de cerámica con esmalte verde y una estrella roja',
  class: className,
} = Astro.props;
---

<svg
  class:list={['lv-art', className]}
  viewBox="0 0 230 210"
  role="img"
  aria-label={label}
  data-draw={draw === 'none' ? undefined : draw}
  data-delay={delay}
>
  <g filter="url(#ink-fino)">
    <path data-fill d="M40 40 L162 40 L152 176 C150 190 54 190 52 176 Z" fill="#EDE6D8" />
    <path data-fill d="M40 40 L162 40 L160 66 C150 60 146 84 136 72 C126 62 120 90 108 74 C96 60 88 88 76 72 C66 60 58 84 46 70 Z" style="fill: var(--verde)" />
    <path data-pop class="lv-art-red-fill" d="M100 98 L108 120 L132 120 L113 134 L120 157 L100 143 L80 157 L87 134 L68 120 L92 120 Z" />
  </g>
  <g filter="url(#ink-fino)" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
    <path data-s d="M40 40 L162 40 L152 176 C150 190 54 190 52 176 Z" />
    <path data-s d="M40 40 C60 32 142 32 162 40" />
    <path data-s d="M160 74 C204 72 206 138 154 136 M158 92 C186 92 186 120 156 120" />
  </g>
</svg>
