---
/**
 * ── The 6 ─────────────────────────────────────────────
 *
 * Para Drake: la CN Tower de Toronto a tinta, con alguien sentado
 * en la orilla de arriba con las piernas colgando, un "6" naranja
 * gigante detrás, luna y estrellas.
 */
interface Props {
  draw?: 'load' | 'scroll' | 'manual' | 'none';
  delay?: number;
  label?: string;
  class?: string;
}

const {
  draw = 'scroll',
  delay = 0,
  label = 'La CN Tower de Toronto con alguien sentado arriba y un 6 naranja detrás',
  class: className,
} = Astro.props;

const ticks = Array.from({ length: 6 }, (_, i) => `M106 ${24 + i * 12} L114 ${24 + i * 12}`).join(' ');
---

<svg
  class:list={['lv-art', className]}
  viewBox="0 0 230 330"
  role="img"
  aria-label={label}
  data-draw={draw === 'none' ? undefined : draw}
  data-delay={delay}
>
  <text
    data-fill
    x="118"
    y="300"
    text-anchor="middle"
    font-size="300"
    font-weight="900"
    fill-opacity="0.85"
    filter="url(#ink)"
    style="fill: var(--pint-naranja); font-family: var(--f-grot); font-stretch: 75%"
  >6</text>

  <g filter="url(#ink-fino)" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <!-- antena -->
    <path data-s stroke-width="3" d="M110 104 L110 6" />
    <path data-s stroke-width="1.6" d={ticks} />
    <!-- pod alto -->
    <path data-s stroke-width="2.4" d="M100 74 C100 68 120 68 120 74 C120 80 100 80 100 74 Z" />
    <!-- pod principal -->
    <path data-s stroke-width="3" d="M80 112 C80 98 140 98 140 112 C140 126 80 126 80 112 Z" />
    <path data-s stroke-width="2.2" d="M84 106 L136 106 M84 118 L136 118" />
    <!-- fuste y patas -->
    <path data-s stroke-width="3" d="M102 124 L94 316 M118 124 L126 316" />
    <path data-s stroke-width="2.6" d="M100 230 L70 316 M120 230 L150 316" />
    <path data-s stroke-width="1.6" d="M100 160 L120 160 M98 200 L122 200 M97 250 L123 250 M96 290 L124 290" />
    <path data-s stroke-width="2.6" d="M40 318 L190 318" />
  </g>

  <!-- alguien sentado en la orilla -->
  <g filter="url(#ink-fino)" fill="currentColor">
    <circle data-pop cx="136" cy="88" r="4.4" />
    <path data-pop d="M132 92 L140 92 L140 104 L132 104 Z" />
    <path data-s d="M134 104 C140 108 146 110 148 118 M138 104 C144 108 150 112 150 122" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
  </g>

  <!-- luna y estrellas -->
  <path data-pop class="lv-art-red-fill" filter="url(#ink-fino)" d="M196 30 C182 32 176 46 182 58 C188 68 202 70 210 64 C198 62 190 52 192 42 C194 36 196 32 196 30 Z" />
  <g class="lv-art-red" fill="currentColor">
    <path data-pop d="M40 40 L42.4 46.6 L49 47 L44 51 L45.6 57.6 L40 54 L34.4 57.6 L36 51 L31 47 L37.6 46.6 Z" />
    <path data-pop d="M184 120 L185.6 124.4 L190 124.6 L186.6 127.4 L187.8 131.8 L184 129.4 L180.2 131.8 L181.4 127.4 L178 124.6 L182.4 124.4 Z" />
  </g>
</svg>
