---
/**
 * ── Timbre ────────────────────────────────────────────
 *
 * Sello de goma entintado, moteado e imperfecto (#sello-f).
 *   circle → texto en el anillo + palabra al centro
 *   rect   → doble marco con dos líneas
 */
interface Props {
  shape?: 'circle' | 'rect';
  /** texto del anillo (circle) o línea de arriba (rect) */
  top: string;
  center: string;
  tone?: 'rojo' | 'azul' | 'tinta' | 'verde';
  label?: string;
  class?: string;
}

const { shape = 'circle', top, center, tone = 'rojo', label, class: className } = Astro.props;
const color = { rojo: 'var(--rojo)', azul: 'var(--azul)', tinta: 'var(--tinta)', verde: 'var(--verde)' }[tone];
const ringId = `timbre-${Math.random().toString(36).slice(2, 8)}`;
const ring = `${top} · ${top} · `;
const size = center.length > 7 ? 34 : center.length > 4 ? 44 : 58;
---

{shape === 'circle' ? (
  <svg class:list={['lv-art', 'timbre', className]} viewBox="0 0 200 200" role="img" aria-label={label ?? `${center} · ${top}`} style={`color: ${color}`}>
    <g filter="url(#sello-f)">
      <circle cx="100" cy="100" r="90" fill="none" stroke="currentColor" stroke-width="5" />
      <circle cx="100" cy="100" r="62" fill="none" stroke="currentColor" stroke-width="2" />
      <path id={ringId} d="M100,100 m-76,0 a76,76 0 1,1 152,0 a76,76 0 1,1 -152,0" fill="none" />
      <text font-size="13" font-weight="700" fill="currentColor" letter-spacing="2" style="font-family: var(--f-grot)">
        <textPath href={`#${ringId}`} textLength="468" lengthAdjust="spacing">{ring.toUpperCase()}</textPath>
      </text>
      <text x="100" y={100 + size * 0.34} text-anchor="middle" font-size={size} font-weight="900" fill="currentColor" style="font-family: var(--f-grot); font-stretch: 75%">{center}</text>
    </g>
  </svg>
) : (
  <svg class:list={['lv-art', 'timbre', className]} viewBox="0 0 280 130" role="img" aria-label={label ?? `${center} · ${top}`} style={`color: ${color}`}>
    <g filter="url(#sello-f)">
      <rect x="6" y="6" width="268" height="118" fill="none" stroke="currentColor" stroke-width="5" />
      <rect x="16" y="16" width="248" height="98" fill="none" stroke="currentColor" stroke-width="1.6" />
      <text x="140" y="46" text-anchor="middle" font-size="14" font-weight="700" fill="currentColor" letter-spacing="3" style="font-family: var(--f-grot)">{top.toUpperCase()}</text>
      <text x="140" y="96" text-anchor="middle" font-size="46" font-weight="900" fill="currentColor" style="font-family: var(--f-grot); font-stretch: 75%">{center}</text>
    </g>
  </svg>
)}
