---
/**
 * ── IV. Memos ─────────────────────────────────────────
 *
 * Encabezado compuesto ("Memos" gigante, "& Ensayos" desfasado y
 * las sardinas encimadas) y una lista escalonada: cada renglón se
 * recorre un poco, como notas pegadas a mano. Al pasar el cursor
 * la pluma subraya el título.
 */
import { getLangFromUrl, useTranslations, getLocalePath } from '../../i18n/utils';
import { memoHref, memoDate, type Memo } from '../../lib/journal';
import Folio from './Folio.astro';
import Sardinas from '../art/Sardinas.astro';
import Pieza from './Pieza.astro';
import Trazo from '../art/Trazo.astro';

interface Props {
  memos: Memo[];
}

const { memos } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const [word, rest] = t('journal.heading').split(/\s*&\s*/);
---

<section class="memos" id="memos">
  <Folio n="IV" title={t('home.s4')} page={5} />

  <header class="memos__head">
    <Pieza x="40%" y="58%" w="34vw" z={0} depth={0} reveal={false} hideMobile>
      <Trazo kind="brochazo" tone="verde" />
    </Pieza>
    <h2 class="memos__title" data-reveal="lines">
      <span class="lv-line memos__w1"><span><em>IV.</em> {word}</span></span>
      {rest && <span class="lv-line memos__w2"><span>&amp; {rest}</span></span>}
    </h2>
    <div class="memos__art"><Sardinas /></div>
  </header>

  <ol class="memo-list">
    {memos.map((memo, i) => (
      <li class:list={['memo', `memo--${(i % 3) + 1}`]}>
        <a href={memoHref(memo, lang)} data-pen-group>
          <span class="memo__n">{String(i + 1).padStart(2, '0')}</span>
          <span class="memo__title"><span data-pen="under">{memo.data.title}</span></span>
          <span class="memo__meta">
            <span data-reveal="type" data-delay={(i * 0.1).toFixed(2)}>{memoDate(memo.data.date)}</span>
            <span>{memo.data.readTime}</span>
          </span>
        </a>
      </li>
    ))}
  </ol>

  <a class="lv-link memos__all" href={getLocalePath('/journal', lang)} data-pen data-reveal="fade">{t('home.memos.cta')} →</a>
</section>

<style>
  .memos {
    display: grid;
  }

  .memos__head {
    position: relative;
    margin-top: clamp(40px, 5vw, 72px);
    margin-bottom: clamp(40px, 6vw, 90px);
  }

  .memos__title {
    position: relative;
    z-index: 2;
    font-family: var(--f-display);
    font-weight: 400;
    line-height: 0.86;
    letter-spacing: -0.045em;
  }

  .memos__w1 { font-size: clamp(4rem, 15vw, 17rem); }
  .memos__w1 em { font-style: italic; color: var(--rojo); font-size: 0.4em; vertical-align: top; }
  .memos__w2 {
    padding-left: 34vw;
    font-size: clamp(2.4rem, 7vw, 8rem);
    font-style: italic;
  }

  .memos__art {
    position: absolute;
    right: 6%;
    top: -4%;
    width: clamp(110px, 14vw, 220px);
    rotate: 14deg;
  }

  .memo-list { list-style: none; }

  .memo a {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    gap: 12px clamp(20px, 3vw, 44px);
    align-items: baseline;
    padding: clamp(22px, 2.6vw, 34px) 0;
    border-top: 1px solid var(--linea);
    color: var(--tinta);
    text-decoration: none;
    transition: translate 0.8s var(--ease-expo);
  }

  /* Renglones escalonados, como notas pegadas a mano */
  .memo--2 a { margin-left: 9vw; }
  .memo--3 a { margin-left: 4vw; margin-right: 6vw; }
  .memo a:hover { translate: 14px 0; }

  .memo__n {
    font-family: var(--f-mono);
    font-size: 0.76rem;
    color: var(--grafito);
  }

  .memo__title {
    font-family: var(--f-display);
    font-size: clamp(1.5rem, 3vw, 2.8rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .memo__title > span { display: inline-block; }

  .memo__meta {
    display: grid;
    justify-items: end;
    gap: 4px;
    font-family: var(--f-mono);
    font-size: 0.76rem;
    color: var(--grafito);
  }

  .memos__all {
    justify-self: end;
    margin-top: clamp(28px, 3vw, 44px);
  }

  @media (max-width: 900px) {
    .memos__w2 { padding-left: 12vw; }
    .memo a { grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .memo--2 a,
    .memo--3 a { margin: 0; }
    .memo__meta { justify-items: start; grid-auto-flow: column; justify-content: start; gap: 16px; }
    .memos__art { top: auto; bottom: -20%; }
  }
</style>
