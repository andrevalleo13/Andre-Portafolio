---
/**
 * ── Iceberg ───────────────────────────────────────────
 *
 * La punta sobre el agua (lo que se ve: la interfaz) y la masa
 * debajo (lo que se siente: la experiencia completa).
 */
import Fig from './Fig.astro';

interface Props {
  n: number;
  caption: string;
  top: { title: string; items: string[] };
  bottom: { title: string; items: string[] };
}

const { n, caption, top, bottom } = Astro.props;
---

<Fig n={n} caption={caption}>
  <div class="ice">
    <svg class="lv-art ice__art" viewBox="0 0 300 300" aria-hidden="true" data-draw="scroll">
      <rect data-fill x="0" y="92" width="300" height="208" style="fill: var(--cielo)" fill-opacity="0.32" />
      <g filter="url(#ink-fino)" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path data-s d="M0 92 C40 86 70 98 110 92 S190 86 230 92 S280 98 300 92" style="stroke: var(--azul)" stroke-width="2.2" />
        <path data-fill d="M118 92 L150 34 L170 60 L186 92 Z" fill="#FBFAF7" />
        <path data-s d="M118 92 L150 34 L170 60 L186 92" stroke="currentColor" stroke-width="2.4" />
        <path data-fill d="M118 92 L186 92 L236 150 L250 222 L206 282 L104 288 L58 226 L70 150 Z" fill="#FBFAF7" fill-opacity="0.75" />
        <path data-s d="M118 92 L70 150 L58 226 L104 288 L206 282 L250 222 L236 150 L186 92" stroke="currentColor" stroke-width="2.4" stroke-dasharray="1 0" />
        <path data-s d="M96 180 L150 200 L214 176 M120 250 L176 236" stroke="currentColor" stroke-width="1.2" stroke-opacity="0.5" />
      </g>
    </svg>
    <div class="ice__top">
      <span class="ice__title">{top.title}</span>
      {top.items.map((it) => <span class="ice__item">{it}</span>)}
    </div>
    <div class="ice__bottom">
      <span class="ice__title is-deep">{bottom.title}</span>
      {bottom.items.map((it) => <span class="ice__item">{it}</span>)}
    </div>
  </div>
</Fig>

<style>
  .ice {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(160px, 260px) minmax(0, 1fr);
    grid-template-areas: 'top art bottom';
    gap: 18px;
    align-items: center;
  }

  .ice__art { grid-area: art; color: var(--tinta); }
  .ice__top { grid-area: top; align-self: start; text-align: right; }
  .ice__bottom { grid-area: bottom; align-self: end; }
  .ice__top, .ice__bottom { display: grid; gap: 6px; }

  .ice__title {
    font-family: var(--f-grot);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rojo);
  }

  .ice__title.is-deep { color: var(--azul); }
  .ice__item { font-family: var(--f-serif); font-size: 1rem; line-height: 1.25; }

  @media (max-width: 560px) {
    .ice { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-areas: 'art art' 'top bottom'; }
    .ice__art { max-width: 220px; justify-self: center; }
    .ice__top { text-align: left; }
  }
</style>
