---
/**
 * ── Tríada ────────────────────────────────────────────
 *
 * Tres tarjetas sueltas, una pregunta por tarjeta (p. ej. Agile,
 * Lean, Bootstrapping). La etiqueta en rojo, la pregunta en itálica.
 */
import Fig from './Fig.astro';

interface Props {
  n: number;
  caption: string;
  items: Array<{ tag: string; q: string; note?: string }>;
}

const { n, caption, items } = Astro.props;
---

<Fig n={n} caption={caption}>
  <div class="tri">
    {items.map((it, i) => (
      <div class:list={['tri__card', `tri__card--${i + 1}`]}>
        <span class="tri__tag">{it.tag}</span>
        <span class="tri__q">{it.q}</span>
        {it.note && <span class="tri__note">{it.note}</span>}
      </div>
    ))}
  </div>
</Fig>

<style>
  .tri {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .tri__card {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 16px 16px 18px;
    background: var(--hoja);
    box-shadow: var(--sombra-hoja);
  }

  .tri__card--1 { rotate: -1.2deg; }
  .tri__card--2 { rotate: 0.8deg; margin-top: 10px; }
  .tri__card--3 { rotate: -0.6deg; }

  .tri__tag {
    font-family: var(--f-grot);
    font-weight: 900;
    font-stretch: 75%;
    font-size: 1.3rem;
    line-height: 1;
    text-transform: uppercase;
    color: var(--rojo);
  }

  .tri__q { font-family: var(--f-serif); font-style: italic; font-size: 1.12rem; line-height: 1.25; }
  .tri__note { font-family: var(--f-grot); font-size: 0.7rem; line-height: 1.4; color: var(--grafito); }

  @media (max-width: 560px) {
    .tri { grid-template-columns: minmax(0, 1fr); }
    .tri__card--2 { margin-top: 0; }
  }
</style>
