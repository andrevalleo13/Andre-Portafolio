---
/**
 * ── Home (ES) ─────────────────────────────────────────
 *
 * Full-viewport hero. The 3D shader IS the design.
 * Text overlays are pure Helvetica Neue — no boxes,
 * no borders, no decoration. Silence = luxury.
 */
import Base from '../../layouts/Base.astro';
import HeroShader from '../../components/HeroShader.jsx';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Base title="André Valle Ortega">
  <section class="hero">
    <HeroShader client:only="react" />

    <div class="hero__content">

      <!-- Descriptor -->
      <p class="hero__descriptor">{t('hero.descriptor')}</p>

      <!-- Name -->
      <h1 class="hero__name">André Valle Ortega</h1>

      <!-- CTAs — no borders, pure type -->
      <div class="hero__cta">
        <a href="/es/work" class="cta-link hover-fill" id="hero-work-cta">
          {t('hero.cta.work')}
        </a>
        <a href="/es/contact" class="cta-link hover-fill" id="hero-contact-cta">
          {t('hero.cta.contact')}
        </a>
      </div>

    </div>

    <!-- Soft fade into the next section -->
    <div class="hero-fade-mask"></div>
  </section>

  <!-- Content below fold -->
  <section class="content-section">
    <!-- Ethos / Manifesto -->
    <div class="ethos wrapper">
      <h2 class="ethos__text">{t('about.heading')}</h2>
      <div class="ethos__subtext split-text">
        {t('about.p1')} {t('about.p2')}
      </div>
    </div>

    <!-- Selected Works (Editorial List) -->
    <div class="work wrapper">
      <div class="work__header">
        <span class="eyebrow">[ {t('work.eyebrow')} 26' ]</span>
      </div>
      
      <ul class="work__list">
        <li class="work__item">
          <a href="https://cordhq.app/" target="_blank" rel="noopener" class="work__link hover-fill" data-image="https://cordhq.app/og-cord.jpg">
            <span class="work-text">Cord</span>
            <svg class="work-arrow" width="0.8em" height="0.8em" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0.5 7.5L7.5 0.5M7.5 0.5H1.5M7.5 0.5V6.5" stroke="currentColor" stroke-width="0.5"/>
            </svg>
          </a>
        </li>
        <li class="work__item">
          <a href="https://flouvia.com/" target="_blank" rel="noopener" class="work__link hover-fill" data-image="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2070&auto=format&fit=crop">
            <span class="work-text">Flouvia</span>
            <svg class="work-arrow" width="0.8em" height="0.8em" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0.5 7.5L7.5 0.5M7.5 0.5H1.5M7.5 0.5V6.5" stroke="currentColor" stroke-width="0.5"/>
            </svg>
          </a>
        </li>
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ── Hero ──────────────────────────────── */
  .hero {
    position: relative;
    width: 100vw;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
  }

  .hero__content {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0 5vw 4.5rem;
  }

  .hero-fade-mask {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 40vh; /* smooth gradient height */
    background: linear-gradient(to bottom, transparent, var(--dark));
    z-index: 5;
    pointer-events: none;
  }

  .content-section {
    position: relative;
    z-index: 10;
    background-color: var(--dark);
    width: 100%;
    padding-bottom: 5rem;
  }

  .wrapper {
    padding: 0 5vw;
    margin: 0 auto;
    max-width: 1400px;
  }

  /* ── Ethos ──────────────────────────────── */
  .ethos {
    padding: 10rem 0 15rem;
  }
  
  .ethos__text {
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: rgba(237, 233, 228, 0.95);
    max-width: 20ch;
    margin-bottom: 2rem;
  }

  .ethos__subtext {
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.6;
    color: rgba(237, 233, 228, 0.5);
    max-width: 45ch;
  }

  /* ── Work (Editorial) ────────────────────── */
  .work {
    padding-bottom: 15rem;
  }

  .work__header {
    margin-bottom: 4rem;
  }

  .eyebrow {
    font-size: 0.62rem;
    font-weight: 300;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(237, 233, 228, 0.4);
  }

  .work__list {
    list-style: none;
    border-top: 1px solid rgba(237, 233, 228, 0.1);
  }

  .work__item {
    border-bottom: 1px solid rgba(237, 233, 228, 0.1);
  }

  .work__link {
    width: 100%;
    font-size: clamp(3rem, 8vw, 8rem);
    font-weight: 300;
    letter-spacing: -0.03em;
    color: rgba(237, 233, 228, 0.85);
    text-decoration: none;
    padding: 2vh 0.2em 2vh 0;
    transition: color 0.4s ease;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .work__link :global(.fill-text) {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    width: 100% !important;
  }

  .work-arrow {
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .work__link:hover .work-arrow {
    transform: translate(0.1em, -0.1em);
  }

  /* When hover-fill active, push text slightly and brighten */
  .work__link:hover {
    color: #14110F;
  }

  /* Descriptor — whisper-weight, high tracking */
  .hero__descriptor {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.58rem;
    font-weight: 300;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(237, 233, 228, 0.95);
    margin-bottom: 1rem;
    opacity: 0;
  }

  /* Name — the centerpiece */
  .hero__name {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: clamp(2.4rem, 5.8vw, 6rem);
    font-weight: 200;
    line-height: 1;
    letter-spacing: -0.03em;
    color: #ede9e4;
    white-space: nowrap;
    margin-bottom: 2.5rem;
    opacity: 0;
  }

  /* CTAs — text only, no chrome */
  .hero__cta {
    display: flex;
    align-items: center;
    gap: 2px;
    opacity: 0;
  }

  .cta-link {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.62rem;
    font-weight: 300;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none !important;
    color: rgba(237, 233, 228, 0.95);
    padding: 0.8rem 1.8rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .cta-link:hover {
    color: rgba(237, 233, 228, 0.95);
  }

  @media (max-width: 600px) {
    .hero__name {
      font-size: clamp(1.8rem, 8vw, 2.8rem);
    }
  }
</style>
