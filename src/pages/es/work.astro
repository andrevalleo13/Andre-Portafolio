---
import Base from '../../layouts/Base.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const projects = [
  {
    id: 'cord',
    name: 'CORD',
    desc: t('work.cord.desc'),
    link: '/es/work/cord',
  },
  {
    id: 'flouvia',
    name: 'FLOUVIA',
    desc: t('work.flouvia.desc'),
    link: '/es/work/flouvia',
  }
];
---

<Base title={`${t('nav.work')} — André Valle Ortega`}>
  <section class="work-section">
    <div class="container work-container">
      <h1 class="section__heading">{t('work.heading')}</h1>
      
      <div class="directory">
        {projects.map((proj) => (
          <a href={proj.link} class="dir-row">
            <div class="dir-row__left">
              <h2 class="dir-row__title">{proj.name}</h2>
            </div>
            <div class="dir-row__right">
              <span class="dir-row__desc">{proj.desc}</span>
              <span class="dir-row__cta">[{t('work.cta')} ↗]</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .work-section {
    padding-top: 15vh;
    padding-bottom: 15vh;
    min-height: 100vh;
  }

  /* Constrain the max width to avoid stretching edge to edge */
  .work-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .directory {
    margin-top: 6rem;
    border-top: 1px solid rgba(237, 233, 228, 0.2);
  }

  .dir-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 3rem 0;
    border-bottom: 1px solid rgba(237, 233, 228, 0.2);
    text-decoration: none;
    color: var(--bone-light);
    transition: color 0.3s ease, padding-left 0.3s ease;
  }

  .dir-row:hover {
    color: #fff;
    padding-left: 1rem;
  }

  .dir-row__left {
    flex: 1;
  }

  .dir-row__title {
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0;
  }

  .dir-row__right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }

  .dir-row__desc {
    font-size: 1rem;
    letter-spacing: 0.05em;
    opacity: 0.7;
    font-weight: 300;
  }

  .dir-row__cta {
    font-family: monospace;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateX(-10px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .dir-row:hover .dir-row__cta {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 768px) {
    .dir-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding: 2rem 0;
    }
    .dir-row__right {
      align-items: flex-start;
    }
    .dir-row__cta {
      opacity: 1;
      transform: none;
    }
    .dir-row:hover {
      padding-left: 0;
    }
  }
</style>
