---
/**
 * ── Home (EN) ─────────────────────────────────────────
 *
 * Full-viewport hero. The 3D shader IS the design.
 * Text overlays are pure Helvetica Neue — no boxes,
 * no borders, no decoration. Silence = luxury.
 */
import Base from '../layouts/Base.astro';
import HeroShader from '../components/HeroShader.jsx';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { getCollection } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allMemos = await getCollection('journal', ({ data }) => {
  return data.lang === lang && data.draft !== true;
});
allMemos.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const recentMemos = allMemos.slice(0, 2);
---

<Base title="André Valle Ortega">
  <section class="hero">
    <HeroShader client:only="react" />

    <div class="hero__content">

      <!-- Descriptor -->
      <p class="hero__descriptor">{t('hero.descriptor')}</p>

      <!-- Name -->
      <h1 class="hero__name">André Valle Ortega</h1>

      <!-- CTAs — no borders, pure type -->
      <div class="hero__cta">
        <a href="/work" class="cta-link hover-fill" id="hero-work-cta">
          {t('hero.cta.work')}
        </a>
        <a href="/contact" class="cta-link hover-fill" id="hero-contact-cta">
          {t('hero.cta.contact')}
        </a>
      </div>

    </div>

    <!-- Soft fade into the next section -->
    <div class="hero-fade-mask"></div>
  </section>

  <!-- Content below fold -->
  <section class="content-section">
    <!-- Ethos / Manifesto -->
    <div class="ethos wrapper">
      <h2 class="ethos__text">{t('about.heading')}</h2>
      <div class="ethos__subtext split-text">
        {t('about.p1')} {t('about.p2')}
      </div>
    </div>

    <!-- Selected Works (Editorial List) -->
    <div class="work wrapper">
      <div class="work__header">
        <span class="eyebrow">{t('work.eyebrow')} 26'</span>
      </div>
      
      <ul class="work__list">
        <li class="work__item">
          <a href="/work/cord" class="work__link hover-fill" data-image="https://cordhq.app/og-cord.jpg">
            <span class="work-text" transition:name="work-title-cord">Cord</span>
            <svg class="work-arrow" width="0.8em" height="0.8em" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0.5 7.5L7.5 0.5M7.5 0.5H1.5M7.5 0.5V6.5" stroke="currentColor" stroke-width="0.5"/>
            </svg>
          </a>
        </li>
        <li class="work__item">
          <a href="/work/flouvia" class="work__link hover-fill" data-image="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2070&auto=format&fit=crop">
            <span class="work-text" transition:name="work-title-flouvia">Flouvia</span>
            <svg class="work-arrow" width="0.8em" height="0.8em" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0.5 7.5L7.5 0.5M7.5 0.5H1.5M7.5 0.5V6.5" stroke="currentColor" stroke-width="0.5"/>
            </svg>
          </a>
        </li>
      </ul>
    </div>

    <!-- Recent Intelligence -->
    <div class="memos wrapper">
      <div class="memos__header">
        <h2 class="section-heading">{t('home.memos.eyebrow')}</h2>
      </div>
      <div class="memo-list">
        {recentMemos.map((memo) => {
          const dateStr = memo.data.date.toISOString().split('T')[0].replace(/-/g, '.');
          return (
            <a href={`/journal/${memo.id}`} class="memo-row">
              <span class="memo-date">{dateStr}</span>
              <h3 class="memo-title">{memo.data.title}</h3>
              <span class="memo-time">{memo.data.readTime}</span>
            </a>
          );
        })}
      </div>
    </div>


  </section>
</Base>

<style>
  /* ── Hero ──────────────────────────────── */
  .hero {
    position: relative;
    width: 100vw;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
  }

  .hero__content {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0 12vw 4.5rem;
  }

  .hero-fade-mask {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 40vh; /* smooth gradient height */
    background: linear-gradient(to bottom, transparent, var(--dark));
    z-index: 5;
    pointer-events: none;
  }

  .content-section {
    position: relative;
    z-index: 10;
    background-color: var(--dark);
    width: 100%;
    padding-bottom: 5rem;
  }

  /* ── Ethos ──────────────────────────────── */
  .ethos {
    padding-top: 10rem;
    padding-bottom: 15rem;
  }
  
  .ethos__text {
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: rgba(237, 233, 228, 0.95);
    max-width: 20ch;
    margin-bottom: 2rem;
  }

  .ethos__subtext {
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.6;
    color: rgba(237, 233, 228, 0.5);
    max-width: 45ch;
  }

  /* ── Work (Editorial) ────────────────────── */
  .work {
    padding-bottom: 15rem;
  }

  .work__header {
    margin-bottom: 4rem;
  }

  .eyebrow {
    font-size: 0.62rem;
    font-weight: 300;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(237, 233, 228, 0.4);
  }

  .work__list {
    list-style: none;
    border-top: 1px solid rgba(237, 233, 228, 0.1);
  }

  .work__item {
    border-bottom: 1px solid rgba(237, 233, 228, 0.1);
  }

  .work__link {
    display: block;
    font-size: clamp(3rem, 8vw, 8rem);
    font-weight: 300;
    letter-spacing: -0.03em;
    color: rgba(237, 233, 228, 0.85);
    text-decoration: none;
    width: 100%;
    padding: 2vh 0.2em 2vh 0;
    transition: color 0.4s ease;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .work__link :global(.fill-text) {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    width: 100% !important;
  }

  .work-arrow {
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .work__link:hover .work-arrow {
    transform: translate(0.1em, -0.1em);
  }

  /* When hover-fill active, push text slightly and brighten */
  .work__link:hover {
    color: #ede9e4;
  }

  /* Descriptor — whisper-weight, high tracking */
  .hero__descriptor {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.58rem;
    font-weight: 300;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(237, 233, 228, 0.95);
    margin-bottom: 1rem;
    opacity: 0;
  }

  /* Name — the centerpiece */
  .hero__name {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: clamp(2.4rem, 5.8vw, 6rem);
    font-weight: 200;
    line-height: 1;
    letter-spacing: -0.03em;
    color: #ede9e4;
    white-space: nowrap;
    margin-bottom: 2.5rem;
    opacity: 0;
  }

  /* CTAs — text only, no chrome */
  .hero__cta {
    display: flex;
    align-items: center;
    gap: 2px;
    opacity: 0;
  }

  .cta-link {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.62rem;
    font-weight: 300;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none !important;
    color: rgba(237, 233, 228, 0.95);
    padding: 0.8rem 1.8rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .cta-link:hover {
    color: rgba(237, 233, 228, 0.95);
  }

  @media (max-width: 600px) {
    .hero__name {
      font-size: clamp(1.8rem, 8vw, 2.8rem);
    }
  }

  /* ── New Sections CSS ────────────────────── */
  .memos {
    padding-bottom: 15rem;
  }

  .memos__header {
    margin-bottom: 4rem;
  }

  .section-heading {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    color: rgba(237, 233, 228, 0.85);
  }

  .memo-list {
    border-top: 1px solid rgba(237, 233, 228, 0.1);
  }

  .memo-row {
    display: flex;
    align-items: baseline;
    padding: 2rem 0;
    border-bottom: 1px solid rgba(237, 233, 228, 0.1);
    text-decoration: none;
    color: var(--bone-light);
    transition: color 0.3s ease, padding-left 0.3s ease;
  }

  .memo-row:hover {
    color: #fff;
    padding-left: 1rem;
  }

  .memo-date {
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    opacity: 0.6;
    flex: 0 0 120px;
  }

  .memo-title {
    flex: 1;
    font-size: clamp(1.2rem, 2vw, 2rem);
    font-weight: 300;
    letter-spacing: -0.01em;
    margin: 0;
    padding-right: 2rem;
  }

  .memo-time {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.4;
    transition: opacity 0.3s ease;
  }

  .memo-row:hover .memo-time {
    opacity: 1;
  }




  @media (max-width: 768px) {
    .memo-row {
      flex-direction: column;
      gap: 0.5rem;
    }
    .memo-date {
      flex: auto;
      font-size: 0.8rem;
    }
    .memo-title {
      padding-right: 0;
    }
    .memo-row:hover {
      padding-left: 0;
    }
  }
</style>
