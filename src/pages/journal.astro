---
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allMemos = await getCollection('journal', ({ data }) => {
  return data.lang === lang && data.draft !== true;
});

allMemos.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title={`${t('nav.journal')} — André Valle Ortega`}>
  <section class="journal-section">
    <div class="container journal-container">
      <h1 class="section__heading">Memos & Essays</h1>
      
      <div class="memo-list">
        {allMemos.map((memo) => {
          const dateStr = memo.data.date.toISOString().split('T')[0].replace(/-/g, '.');
          return (
            <a href={`/journal/${memo.id}`} class="memo-item">
              <span class="memo-date">{dateStr}</span>
              <h3 class="memo-title">{memo.data.title}</h3>
              <span class="memo-time">{memo.data.readTime}</span>
            </a>
          );
        })}
        {allMemos.length === 0 && (
          <p style="opacity: 0.5; font-family: monospace;">No memos published yet.</p>
        )}
      </div>
      <Newsletter />
    </div>
  </section>
</Base>

<style>
  .journal-section {
    padding-top: 15vh;
    padding-bottom: 15vh;
    min-height: 100vh;
  }

  .journal-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .memo-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4rem 2rem;
    padding-top: 2rem;
  }

  .memo-item {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    text-decoration: none;
    transition: transform 0.4s ease;
  }

  .memo-item:hover {
    transform: translateY(-4px);
  }

  .memo-date {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: rgba(237, 233, 228, 0.4);
    margin-bottom: 1.5rem;
  }

  .memo-title {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 2rem 0;
    color: rgba(237, 233, 228, 0.85);
    transition: color 0.4s ease;
  }

  .memo-item:hover .memo-title {
    color: #ffffff;
  }

  .memo-time {
    margin-top: auto;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(237, 233, 228, 0.3);
  }

  /* ── Asymmetrical Bento Logic ── */
  
  .memo-item:nth-child(6n + 1),
  .memo-item:nth-child(6n + 2) {
    grid-column: span 1;
  }
  .memo-item:nth-child(6n + 1) .memo-title,
  .memo-item:nth-child(6n + 2) .memo-title {
    font-size: clamp(1.2rem, 2vw, 1.8rem);
  }

  .memo-item:nth-child(6n + 3) {
    grid-column: span 2;
  }

  .memo-item:nth-child(6n + 4) {
    grid-column: span 4;
    padding: 6rem 0;
    align-items: center;
    text-align: center;
  }
  .memo-item:nth-child(6n + 4) .memo-title {
    font-size: clamp(3rem, 6vw, 6rem);
    max-width: 14ch;
  }
  .memo-item:nth-child(6n + 4) .memo-date {
    margin-bottom: 2rem;
  }

  .memo-item:nth-child(6n + 5),
  .memo-item:nth-child(6n + 6) {
    grid-column: span 2;
  }
  .memo-item:nth-child(6n + 5) .memo-title,
  .memo-item:nth-child(6n + 6) .memo-title {
    font-size: clamp(1.8rem, 3vw, 2.8rem);
  }

  @media (max-width: 1024px) {
    .memo-list {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem 1.5rem;
    }
    .memo-item:nth-child(n) {
      grid-column: span 1;
      padding: 0;
      align-items: flex-start;
      text-align: left;
    }
    .memo-item:nth-child(n) .memo-title {
      font-size: clamp(1.5rem, 4vw, 2rem);
      max-width: none;
    }
    .memo-item:nth-child(n) .memo-date {
      margin-bottom: 1.5rem;
    }
    .memo-item:nth-child(6n + 4) {
      grid-column: span 2;
      padding: 3rem 0;
    }
    .memo-item:nth-child(6n + 4) .memo-title {
      font-size: clamp(2.5rem, 6vw, 4rem);
    }
  }

  @media (max-width: 600px) {
    .memo-list {
      grid-template-columns: 1fr;
    }
    .memo-item:nth-child(n) {
      grid-column: span 1;
    }
    .memo-item:nth-child(6n + 4) {
      padding: 2rem 0;
    }
  }
</style>
