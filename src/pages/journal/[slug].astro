---
/**
 * ── Journal: memo (EN) ────────────────────────────────
 *
 * El contenido vive en src/components/JournalPost.astro (compartido con ES).
 */
import Base from '../../layouts/Base.astro';
import JournalPost from '../../components/JournalPost.astro';
import { memoPaths } from '../../lib/journal';

export function getStaticPaths() {
  return memoPaths('en');
}

const { memo, n, next } = Astro.props;
---

<Base title={`${memo.data.title} — André Valle Ortega`}>
  <JournalPost memo={memo} n={n} next={next} />
</Base>
