---
/**
 * ── Work: caso (EN) ───────────────────────────────────
 *
 * Cord y Flouvia tienen página propia (CaseCord, CaseFlouvia); el resto usa WorkCase.
 */
import Base from '../../layouts/Base.astro';
import CaseCord from '../../components/CaseCord.astro';
import CaseFlouvia from '../../components/CaseFlouvia.astro';
import WorkCase from '../../components/WorkCase.astro';
import { workPaths, workSlug } from '../../lib/work';

export function getStaticPaths() {
  return workPaths('en');
}

const { project, lot, next, nextLot } = Astro.props;

/* Cada caso tiene su propia página; WorkCase queda para los que no. */
const PAGES = { cord: CaseCord, flouvia: CaseFlouvia } as const;
const Page = PAGES[workSlug(project.id) as keyof typeof PAGES] ?? WorkCase;
---

<Base title={`${project.data.title} — Work`} description={project.data.subtitle}>
  <Page project={project} lot={lot} next={next} nextLot={nextLot} />
</Base>
